# XDG Base Directory (macOS에서 lazygit 등 CLI 도구가 ~/.config/ 를 사용하도록)
export XDG_CONFIG_HOME="$HOME/.config"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Starship을 사용하므로 Oh My Zsh 테마 비활성화
ZSH_THEME=""

plugins=(git)

source $ZSH/oh-my-zsh.sh

# ============================================================
# zsh-autosuggestions + zsh-syntax-highlighting
# ============================================================
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew로 설치된 플러그인 로드
if [ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [ -f "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{ else -}}
# Linux: Oh My Zsh 플러그인 디렉토리에서 로드
[ -f "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
[ -f "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# ============================================================
# Homebrew
# ============================================================
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# ============================================================
# Java
# ============================================================
if [ -d "/opt/homebrew/opt/openjdk@17" ]; then
    export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
    export JAVA_HOME="/opt/homebrew/opt/openjdk@17"
fi

# ============================================================
# MySQL Client
# ============================================================
if [ -d "/opt/homebrew/opt/mysql-client" ]; then
    export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
fi

# ============================================================
# Bun
# ============================================================
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ============================================================
# Android Studio
# ============================================================
if [ -d "$HOME/Library/Android/sdk" ]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
    export PATH="$PATH:$ANDROID_HOME/emulator"
    export PATH="$PATH:$ANDROID_HOME/platform-tools"
fi

{{ end -}}
# ============================================================
# nvm + Node.js
# ============================================================
export NVM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

{{ if hasKey . "nvm_auto_use_hook" -}}
{{ if .nvm_auto_use_hook -}}
# 프로젝트가 제공하는 .nvmrc auto-use 훅. 경로는 머신별 설정이라
# chezmoi.toml의 nvm_auto_use_hook에 두고 repo에는 담지 않는다.
#
# 마커(>>> <<<)는 zambaguni-front의 install-nvm-auto-use.sh --check가
# 블록을 인식하는 데 쓰므로 지우지 않는다.
# >>> zambaguni nvm auto-use >>>
if [[ -r {{ .nvm_auto_use_hook }} ]]; then
  source {{ .nvm_auto_use_hook }}
fi
# <<< zambaguni nvm auto-use <<<
{{ end -}}
{{ end -}}

# ============================================================
# PATH 추가
# ============================================================
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/.pub-cache/bin"
export PATH="$PATH:$HOME/.maestro/bin"

# nvm 경로를 PATH 맨 앞으로 끌어온다.
#
# nvm.sh 를 source 하는 것만으로는 `node` 가 nvm 판으로 잡히지 않는다. nvm 은 PATH 에
# nvm 경로가 이미 있으면 **그 자리에서 버전만 교체**하기 때문이다(실측: 8번 위치의
# v24.18.1/bin 이 v24.19.0/bin 으로 바뀌지만 위치는 8번 그대로). tmux 서버가 물려주는
# PATH 에 nvm 이 Homebrew 뒤에 박혀 있으면 그 순서가 새 셸마다 재생산되고, 결과적으로
# Homebrew node 가 계속 이긴다 — `nvm current` 가 `system` 을 내고 `node` 는
# /opt/homebrew/bin/node 였다. Homebrew node 는 firebase-cli·supabase 의 의존성이라
# 지울 수 없으므로 여기서 순서를 바로잡는다.
#
# `nvm use` 를 다시 부르지 않는다 — 위 이유로 효과가 없고 약 150ms 를 더한다. nvm.sh
# 가 이미 올바른 버전의 경로를 넣어 두었으니 그 항목을 앞으로 옮기기만 하면 되고,
# 이 방식은 외부 명령을 쓰지 않아 비용이 없다.
if [[ -n "${NVM_DIR:-}" ]]; then
    _nvm_paths=("${(@M)path:#$NVM_DIR/versions/node/*/bin}")
    if (( $#_nvm_paths )); then
        path=("${_nvm_paths[@]}" "${(@)path:#$NVM_DIR/versions/node/*/bin}")
        export PATH
    fi
    unset _nvm_paths
fi

# ============================================================
# Aliases
# ============================================================
alias dotfiles='cd ~/code/dotfiles'

# eza (ls 대체)
if command -v eza &>/dev/null; then
    alias ls='eza --icons'
    alias ll='eza -lah --icons --git'
else
    alias ll='ls -lah'
fi

# bat (cat 대체)
if command -v bat &>/dev/null; then
    alias cat='bat --style=auto'
fi

# ============================================================
# Ghostty 셸 통합
#
# Ghostty는 자기가 직접 띄운 셸에만 통합을 자동 주입한다. 아래 tmux 블록이
# exec tmux를 하므로 tmux가 다시 띄우는 셸에는 주입되지 않는다 —
# ghostty-integration 파일 상단 주석이 tmux를 그 사례로 명시하고 이 코드를
# 권장한다. 반드시 exec tmux **앞**에 두어야 한다(exec 이후는 실행 안 됨).
#
# 멱등하다: 비대화형 셸과 이미 초기화된 셸에서는 즉시 return 0 한다.
# 켜지는 기능은 GHOSTTY_SHELL_FEATURES가 결정한다 (현재 cursor:blink,path,title).
# ============================================================
if [[ -n "$GHOSTTY_RESOURCES_DIR" ]]; then
    source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# ============================================================
# tmux 자동 연결 (재부팅 후에도 세션 복원)
#
# 이 로직은 tmux 밖의 새 대화형 셸에서만 실행된다 — pane 안은 $TMUX 가드에
# 걸려 애초에 대상이 아니다. `-A`라서 1-main 세션이 살아 있으면 그대로 붙고,
# Ghostty를 완전히 종료해도 tmux 서버는 데몬으로 남아 세션이 유지된다. 세션
# 자체를 새로 만들려면 `tmux kill-session -t 1-main`이 필요하다.
#
# quick 세션: 예전 Quick Terminal이 만든 세션의 이름은 `quick`이었고, 지우는 대신
# `5-quick`으로 개명해 세션 이름 규칙에 편입했다(docs/tmux.md 참고). 아직 구 이름이
# 남은 머신에서는 resurrect가 `quick`을 스냅샷에 담아 재부팅마다 되살리므로,
# `tmux rename-session -t quick 5-quick` 후 `prefix + C-s`로 다시 저장해야 한다.
# `kill-session -t 5-quick`으로는 구 이름 세션을 지울 수 없다 — tmux 타깃 접두사
# 매칭은 세션명이 타깃으로 시작할 때만 성립하고 `quick`은 `5-quick`으로 시작하지 않는다.
#
# ORCA_PANE_KEY 가드: Orca(ADE)는 pane마다 ORCA_WORKTREE_ID,
# ORCA_AGENT_HOOK_{PORT,TOKEN} 등을 주입하고 탭·split·스크롤백·세션 복원을
# 자체적으로 관리한다. 여기서 tmux를 exec하면 `-A`가 기존 1-main 세션에 붙어
# 그 주입값이 전달되지 않고(tmux update-environment 기본값에 ORCA_*가 없음),
# 워크트리별 cwd 격리와 에이전트 상태 표시가 깨진다. 그래서 Orca에서는 우회한다.
#
# 2026-07-29에 Orca를 제거하고 workmux로 옮겼으므로 이 가드는 현재 발동하지 않는다.
# 다시 설치했을 때 같은 문제를 반복하지 않도록 방어용으로 남겨둔다.
# ============================================================
if command -v tmux &>/dev/null && [[ -z "$TMUX" ]] && [[ $- == *i* ]] \
    && [[ -z "$ORCA_PANE_KEY" ]]; then
    # 구 이름 세션 경고: `-A`는 정확 매칭이라 `main`이 살아 있어도 붙지 않고 별도
    # `1-main`을 만든다. 기존 작업이 그쪽에 남는 것을 모르면 사라진 것처럼 보이므로
    # 알린다. 개명은 자동으로 하지 않는다 — 붙어 있는 클라이언트와 실행 중 프로세스가
    # 걸린 판단이라 셸 시작 경로에서 자동으로 처리할 일이 아니다(docs/tmux.md 참고).
    #
    # 서버가 살아 있으면 실제 세션 목록을 보고, 없으면(콜드 스타트) continuum이 곧
    # 복원할 resurrect 스냅샷을 본다. 스냅샷을 보지 않으면 콜드 스타트에서 경고가
    # 통째로 우회된다 — 검사가 조용히 실패한 뒤 복원이 구 이름 세션을 되살린다.
    # 목록 비교는 정확 매칭으로 한다. tmux 타깃 접두사 매칭은 `maintenance` 같은
    # 이름에도 걸린다.
    _legacy='^(main|review|personal|eslint|quick)$'
    if _sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null); then
        _sessions=$(print -r -- "$_sessions" | grep -E "$_legacy")
    elif [[ -r "$HOME/.local/share/tmux/resurrect/last" ]]; then
        _sessions=$(awk -F'\t' '$1=="pane"||$1=="window"{print $2}' \
            "$HOME/.local/share/tmux/resurrect/last" | sort -u | grep -E "$_legacy")
    else
        _sessions=''
    fi
    if [[ -n "$_sessions" ]]; then
        print -u2 "⚠ 규칙 이전 이름의 tmux 세션이 남아 있습니다: ${_sessions//$'\n'/, }"
        print -u2 "  지금 붙는 '1-main'은 별도 세션이라 기존 작업이 보이지 않습니다."
        print -u2 "  이관: tmux-migrate-session-names --dry-run 으로 먼저 확인하세요."
        print -u2 "  자세히: docs/tmux.md 의 '기존 세션 개명'"
    fi
    unset _legacy _sessions

    # 모든 대화형 터미널 → 1-main 세션 (continuum이 자동 복원)
    # 세션명 접두사(1-, 2-...)는 choose-tree/list-sessions의 이름순 정렬을 고정하기 위한 것.
    exec tmux new-session -A -s 1-main
fi

# ============================================================
# fastfetch (터미널 시작 시 시스템 정보 표시)
# ============================================================
if command -v fastfetch &>/dev/null && [[ $- == *i* ]]; then
    fastfetch
fi

# ============================================================
# zoxide (cd 대체)
# ============================================================
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# ============================================================
# fzf (Ctrl+T 파일 검색, Ctrl+R 히스토리 검색, Alt+C 디렉토리 이동)
# ============================================================
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh)"
fi

# ============================================================
# tmux soft-wrap 복사 버그 워크어라운드
# ============================================================
_tmux_fix_copy() {
  [[ -n "$TMUX" ]] && tmux refresh-client
}
add-zsh-hook precmd _tmux_fix_copy

# ============================================================
# AWS
# ============================================================
export AWS_PROFILE=work

# ============================================================
# Starship prompt (마지막에 로드)
# ============================================================
eval "$(starship init zsh)"
