#!/opt/homebrew/bin/python3
import os
import sys

provider = os.environ["AI_TEST_FAKE_CLI_PROVIDER"]
if sys.argv[1:] == ["--version"]:
    print("codex-cli 0.154.0" if provider == "codex" else "2.1.272 (Claude Code)")
elif sys.argv[1:] == ["--help"]:
    if provider == "codex":
        print("--model --sandbox")
    else:
        print("--settings --plugin-dir")
else:
    raise SystemExit(97)
