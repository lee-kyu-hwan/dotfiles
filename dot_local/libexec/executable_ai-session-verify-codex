#!/usr/bin/env python3
"""Redacted adapter for the reviewed Codex doctor JSON surface."""

from __future__ import annotations

import json
import os
import subprocess


FIELDS = {
    "provider", "account_profile", "login_status", "identity_status",
    "usage_status", "cost_limit_status",
}
SIGNALS = (
    "stored API key", "stored ChatGPT tokens", "stored agent identity",
)


def _cost_status() -> str:
    auth_kind = os.environ.get("AI_AUTH_KIND")
    if auth_kind in {"consumer", "organization"}:
        return "not_applicable"
    return "unknown"


def _base_result() -> dict[str, str]:
    return {
        "provider": "codex",
        "account_profile": os.environ.get("AI_ACCOUNT_PROFILE", ""),
        "login_status": "unknown",
        "identity_status": "unknown",
        "usage_status": "usage_unknown",
        "cost_limit_status": _cost_status(),
    }


def _official_status() -> object:
    completed = subprocess.run(
        ["codex", "doctor", "--json"],
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
        close_fds=True,
        pass_fds=(),
    )
    if completed.returncode != 0:
        raise ValueError("official status failed")
    return json.loads(completed.stdout)


def verify() -> dict[str, str]:
    result = _base_result()
    try:
        raw = _official_status()
        if not isinstance(raw, dict):
            return result
        checks = raw.get("checks")
        if not isinstance(checks, dict):
            return result
        credentials = checks.get("auth.credentials")
        if not isinstance(credentials, dict) or credentials.get("category") != "auth":
            return result
        details = credentials.get("details")
        if not isinstance(details, dict):
            return result
        values = tuple(details.get(name) for name in SIGNALS)
        if any(value not in {"true", "false"} for value in values):
            return result
        if details.get("stored auth mode") != "chatgpt":
            return result
        if values == ("false", "false", "false"):
            result["login_status"] = "not_logged_in"
            return result
        if values[0] == "true" or not any(value == "true" for value in values[1:]):
            return result
        result["login_status"] = "logged_in"
        if os.environ.get("AI_IDENTITY_CONTRACT") == "unavailable":
            result["identity_status"] = "unavailable"
    except (OSError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
        pass
    return result


def main() -> int:
    payload = verify()
    if set(payload) != FIELDS:
        payload = _base_result()
    print(json.dumps(payload, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
