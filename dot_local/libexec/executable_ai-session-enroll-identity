#!/usr/bin/env python3
"""Explicit host-local enrollment of a canonical identity digest."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import tomllib

from ai_session_identity import digest_line, find_duplicate_enrollment


ALIAS = re.compile(r"[a-z0-9][a-z0-9._-]*\Z")


def _record(
    provider: str, profile: str, *, success: bool, status: str = "blocked_verifier"
) -> dict[str, object]:
    if success:
        return {
            "schema_version": 1,
            "event": "enrolled_identity",
            "provider": provider,
            "account_profile": profile,
            "status": "enrolled",
        }
    return {
        "schema_version": 1,
        "event": "identity_enrollment_failure",
        "provider": provider,
        "account_profile": profile,
        "status": status,
        "exit_code": 3,
    }


def _load_account(
    registry: Path, provider: str, profile: str
) -> tuple[dict[str, object], tuple[str, ...]]:
    if registry.is_symlink():
        raise ValueError("unsafe registry")
    with registry.open("rb") as stream:
        raw = tomllib.load(stream)
    accounts = raw.get("accounts")
    if (
        raw.get("schema_version") != 2
        or raw.get("contract_id") != "orchestrator-permission-profiles-v2"
        or not isinstance(accounts, list)
    ):
        raise ValueError("invalid registry")
    seen_aliases = set()
    for account in accounts:
        if not isinstance(account, dict):
            raise ValueError("invalid account")
        alias = account.get("alias")
        account_provider = account.get("provider")
        enabled = account.get("enabled", account.get("auth_kind") != "api_payg")
        expected_identity_contract = {
            "claude": "claude_auth_status_v1",
            "codex": "unavailable",
        }.get(account_provider)
        if (
            not isinstance(alias, str)
            or ALIAS.fullmatch(alias) is None
            or alias in seen_aliases
            or expected_identity_contract is None
            or account.get("identity_contract") != expected_identity_contract
            or account.get("identity_enrollment_policy") != "explicit_only"
            or not isinstance(enabled, bool)
        ):
            raise ValueError("invalid account")
        seen_aliases.add(alias)
    matches = [
        account for account in accounts
        if account.get("alias") == profile and account.get("provider") == provider
    ]
    if len(matches) != 1 or matches[0].get("identity_enrollment_policy") != "explicit_only":
        raise ValueError("account is not enrollable")
    if provider != "claude" or matches[0].get("identity_contract") != "claude_auth_status_v1":
        raise ValueError("account identity is unavailable for enrollment")
    other_aliases = []
    if matches[0].get("enabled", matches[0].get("auth_kind") != "api_payg") is not True:
        raise ValueError("account is not active")
    for account in accounts:
        alias = account.get("alias")
        if (
            alias != profile
            and account.get("enabled", account.get("auth_kind") != "api_payg") is True
            and account.get("provider") == "claude"
            and account.get("identity_contract") == "claude_auth_status_v1"
            and account.get("identity_enrollment_policy") == "explicit_only"
        ):
            other_aliases.append(alias)
    return matches[0], tuple(sorted(other_aliases))


def _status_environment(account: dict[str, object], provider: str) -> dict[str, str]:
    environment = os.environ.copy()
    environment.pop("CODEX_HOME", None)
    environment.pop("CLAUDE_CONFIG_DIR", None)
    home = account.get("config_home")
    mode = account.get("config_home_mode")
    if provider == "codex":
        if not isinstance(home, str):
            raise ValueError("Codex home is invalid")
        environment["CODEX_HOME"] = str(Path(home).expanduser())
    elif mode == "explicit":
        if not isinstance(home, str):
            raise ValueError("Claude home is invalid")
        environment["CLAUDE_CONFIG_DIR"] = str(Path(home).expanduser())
    elif mode != "provider_default" or home is not None:
        raise ValueError("Claude home mode is invalid")
    return environment


def _identity_status(account: dict[str, object], provider: str) -> dict[str, object]:
    if os.environ.get("AI_SESSION_SYNTHETIC_TEST") == "1":
        encoded = os.environ.get("AI_SESSION_SYNTHETIC_STATUS_JSON")
        if encoded is None:
            raise ValueError("synthetic status is missing")
        raw = json.loads(encoded)
    else:
        command = ["claude", "auth", "status", "--json"]
        completed = subprocess.run(
            command,
            env=_status_environment(account, provider),
            text=True,
            capture_output=True,
            timeout=10,
            check=False,
            close_fds=True,
            pass_fds=(),
        )
        if completed.returncode != 0:
            raise ValueError("official status failed")
        raw = json.loads(completed.stdout)
    if not isinstance(raw, dict) or raw.get("loggedIn") is not True:
        raise ValueError("official stable identity is unavailable")
    return raw


def _ensure_owner_directory(path: Path) -> None:
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        path.mkdir(mode=0o700)
        metadata = path.lstat()
    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        raise ValueError("identity directory is unsafe")
    if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) != 0o700:
        raise ValueError("identity directory owner or mode is invalid")


def _atomic_write_digest(directory: Path, filename: str, data: bytes) -> None:
    destination = directory / filename
    try:
        current = destination.lstat()
    except FileNotFoundError:
        current = None
    if current is not None and (
        stat.S_ISLNK(current.st_mode)
        or not stat.S_ISREG(current.st_mode)
        or current.st_uid != os.getuid()
        or stat.S_IMODE(current.st_mode) != 0o600
    ):
        raise ValueError("identity digest target is unsafe")
    directory_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        directory_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    directory_fd = os.open(directory, directory_flags)
    temporary_name = f".identity-{secrets.token_hex(12)}.tmp"
    descriptor = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(temporary_name, flags, 0o600, dir_fd=directory_fd)
        os.fchmod(descriptor, 0o600)
        view = memoryview(data)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        if os.environ.get("AI_SESSION_TEST_FAIL_BEFORE_REPLACE") == "1":
            raise OSError("synthetic pre-replace failure")
        os.replace(
            temporary_name,
            filename,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def enroll(arguments: argparse.Namespace) -> None:
    if not ALIAS.fullmatch(arguments.account_profile):
        raise ValueError("invalid account profile")
    account, other_aliases = _load_account(
        arguments.registry, arguments.provider, arguments.account_profile
    )
    identity = _identity_status(account, arguments.provider)
    encoded = digest_line(identity, "claude_auth_status_v1")
    root = Path(
        os.environ.get(
            "AI_SESSION_IDENTITY_ROOT",
            str(Path.home() / ".local/share/ai-account-profiles/identities"),
        )
    )
    if not root.is_absolute():
        raise ValueError("identity root must be absolute")
    provider_directory = root / arguments.provider
    if find_duplicate_enrollment(
        encoded,
        (provider_directory / f"{alias}.sha256" for alias in other_aliases),
    ):
        raise RuntimeError("duplicate_mapping")
    _ensure_owner_directory(root)
    _ensure_owner_directory(provider_directory)
    _atomic_write_digest(provider_directory, f"{arguments.account_profile}.sha256", encoded)


def main() -> int:
    parser = argparse.ArgumentParser(prog="ai-session-enroll-identity")
    parser.add_argument("--registry", type=Path, required=True)
    parser.add_argument("--provider", choices=("claude", "codex"), required=True)
    parser.add_argument("--account-profile", required=True)
    arguments = parser.parse_args()
    try:
        enroll(arguments)
    except RuntimeError as error:
        status = "duplicate_mapping" if str(error) == "duplicate_mapping" else "blocked_verifier"
        print(json.dumps(
            _record(
                arguments.provider,
                arguments.account_profile,
                success=False,
                status=status,
            ),
            separators=(",", ":"),
            sort_keys=True,
        ))
        return 3
    except (OSError, ValueError, json.JSONDecodeError, tomllib.TOMLDecodeError, subprocess.TimeoutExpired):
        print(json.dumps(
            _record(arguments.provider, arguments.account_profile, success=False),
            separators=(",", ":"),
            sort_keys=True,
        ))
        return 3
    print(json.dumps(
        _record(arguments.provider, arguments.account_profile, success=True),
        separators=(",", ":"),
        sort_keys=True,
    ))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
