class PolicyError(Exception):
    def __init__(self, status: str, detail: str):
        super().__init__(detail)
        self.status = status


ROLE_CONTRACT_ID = "orchestrator-permission-profiles-v1"
SKILL_POLICY_FIELDS = {
    "version",
    "policy_id",
    "discovered_catalog",
    "allow",
    "task_overlay",
    "deny",
    "capabilities",
    "capability_deny",
    "status_hook_capabilities",
}


def strip_toml_comment(line: str) -> str:
    quote = None
    escaped = False
    for index, character in enumerate(line):
        if escaped:
            escaped = False
            continue
        if quote == '"' and character == "\\":
            escaped = True
            continue
        if character in {'"', "'"}:
            quote = None if quote == character else character if quote is None else quote
            continue
        if character == "#" and quote is None:
            return line[:index]
    return line


def role_manifest_path() -> Path:
    source_path = Path(__file__).resolve().parents[2] / "dot_config/ai-session/roles.toml"
    if source_path.is_file():
        return source_path
    config_root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_root / "ai-session/roles.toml"


def load_restricted_manifest_policy(
    manifest_path: Path, role: str, provider: str
) -> dict[str, object]:
    target_section = f"roles.{role}.{provider}"
    scalar_keys = (
        {
            "approval",
            "cli_version_range",
            "effort",
            "instruction_path",
            "instruction_sha256",
            "instruction_version",
            "model",
            "permission_generation",
            "sandbox",
            "write_root",
        }
        if provider == "codex"
        else {
            "common_settings_sha256",
            "cli_version_range",
            "effort",
            "elevated_effort",
            "elevation_reason",
            "instruction_path",
            "instruction_sha256",
            "instruction_version",
            "model",
            "settings_path",
            "settings_sha256",
            "settings_version",
        }
    )
    list_keys = (
        {"benign_project_config_keys", "cli_forbidden_options", "cli_required_options"}
        if provider == "codex"
        else {
            "benign_settings_keys",
            "cli_forbidden_options",
            "cli_required_options",
            "denied_permissions",
            "plugin_dirs",
        }
    )
    policy: dict[str, object] = {}
    section = ""
    collecting_key = None
    collecting_value: list[str] = []
    try:
        lines = manifest_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise PolicyError("blocked_policy", "Codex role policy is unavailable") from error
    for raw_line in lines:
        line = strip_toml_comment(raw_line).strip()
        if collecting_key is not None:
            collecting_value.append(line)
            if "]" in line:
                try:
                    policy[collecting_key] = ast.literal_eval("\n".join(collecting_value))
                except (SyntaxError, ValueError) as error:
                    raise PolicyError("blocked_policy", "Codex role policy is invalid") from error
                collecting_key = None
                collecting_value = []
            continue
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section != target_section:
            continue
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*=\s*(.+)", line)
        if match is None:
            raise PolicyError("blocked_policy", "Codex role policy is invalid")
        key, encoded_value = match.groups()
        if key in list_keys and encoded_value.startswith("["):
            collecting_key = key
            collecting_value = [encoded_value]
            if "]" in encoded_value:
                try:
                    policy[key] = ast.literal_eval(encoded_value)
                except (SyntaxError, ValueError) as error:
                    raise PolicyError("blocked_policy", "Codex role policy is invalid") from error
                collecting_key = None
                collecting_value = []
            continue
        if key not in scalar_keys:
            raise PolicyError("blocked_policy", "Codex role policy contains an unknown key")
        try:
            policy[key] = ast.literal_eval(encoded_value)
        except (SyntaxError, ValueError) as error:
            raise PolicyError("blocked_policy", "Codex role policy is invalid") from error
    if collecting_key is not None:
        raise PolicyError("blocked_policy", "Codex role policy is invalid")
    return policy


def load_restricted_section(
    path: Path,
    target_section: str,
    scalar_keys: set[str],
    list_keys: set[str],
) -> dict[str, object]:
    values: dict[str, object] = {}
    section = ""
    collecting_key = None
    collecting_value: list[str] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise PolicyError("blocked_policy", "policy manifest is unavailable") from error
    for raw_line in lines:
        line = strip_toml_comment(raw_line).strip()
        if collecting_key is not None:
            collecting_value.append(line)
            if "]" in line:
                try:
                    values[collecting_key] = ast.literal_eval("\n".join(collecting_value))
                except (SyntaxError, ValueError) as error:
                    raise PolicyError("blocked_policy", "policy manifest is invalid") from error
                collecting_key = None
                collecting_value = []
            continue
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section != target_section:
            continue
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*=\s*(.+)", line)
        if match is None:
            raise PolicyError("blocked_policy", "policy manifest is invalid")
        key, encoded_value = match.groups()
        if key not in scalar_keys | list_keys or key in values:
            raise PolicyError("blocked_policy", "policy manifest contains an unknown key")
        if key in list_keys and encoded_value.startswith("["):
            collecting_key = key
            collecting_value = [encoded_value]
            if "]" in encoded_value:
                try:
                    values[key] = ast.literal_eval(encoded_value)
                except (SyntaxError, ValueError) as error:
                    raise PolicyError("blocked_policy", "policy manifest is invalid") from error
                collecting_key = None
                collecting_value = []
            continue
        if key not in scalar_keys:
            raise PolicyError("blocked_policy", "policy manifest list is invalid")
        try:
            values[key] = ast.literal_eval(encoded_value)
        except (SyntaxError, ValueError) as error:
            raise PolicyError("blocked_policy", "policy manifest is invalid") from error
    if collecting_key is not None:
        raise PolicyError("blocked_policy", "policy manifest is invalid")
    return values


def verify_manifest_schema(path: Path) -> None:
    values: dict[str, object] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise PolicyError("blocked_policy", "policy manifest is unavailable") from error
    for raw_line in lines:
        line = strip_toml_comment(raw_line).strip()
        if not line:
            continue
        if line.startswith("["):
            break
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*=\s*(.+)", line)
        if match is None or match.group(1) in values:
            raise PolicyError("blocked_policy", "policy manifest schema is invalid")
        try:
            values[match.group(1)] = ast.literal_eval(match.group(2))
        except (SyntaxError, ValueError) as error:
            raise PolicyError("blocked_policy", "policy manifest schema is invalid") from error
    if values != {"schema_version": 1}:
        raise PolicyError("blocked_policy", "policy manifest schema version is invalid")


def load_role_capability_policy(role: str, requested_mode: str | None) -> dict[str, object]:
    manifest_path = role_manifest_path()
    verify_manifest_schema(manifest_path)
    common_scalar = {"default_leader_mode", "registry_contract", "skill_policy_id"}
    common_lists = {"leader_modes", "capabilities"}
    global_scalar = {
        "default_leader_mode",
        "registry_contract",
        "active_skill_policy_id",
        "reviewer_skill_policy_id",
        "standby_skill_policy_id",
    }
    global_lists = {
        "leader_modes",
        "active_capabilities",
        "reviewer_capabilities",
        "standby_capabilities",
    }
    expected = global_scalar | global_lists if role == "global-orchestrator" else common_scalar | common_lists
    policy = load_restricted_section(
        manifest_path,
        f"roles.{role}",
        global_scalar if role == "global-orchestrator" else common_scalar,
        global_lists if role == "global-orchestrator" else common_lists,
    )
    if set(policy) != expected:
        raise PolicyError("blocked_role_schema", "role capability policy is incomplete")
    if policy["registry_contract"] != ROLE_CONTRACT_ID:
        raise PolicyError("blocked_contract", "registry contract token is invalid")
    modes = policy["leader_modes"]
    default_mode = policy["default_leader_mode"]
    if not isinstance(modes, list) or not modes or any(not isinstance(item, str) for item in modes):
        raise PolicyError("blocked_role_schema", "leader modes are invalid")
    if not isinstance(default_mode, str) or default_mode not in modes:
        raise PolicyError("blocked_role_schema", "default leader mode is invalid")
    leader_mode = requested_mode or default_mode
    if leader_mode not in modes:
        raise PolicyError("blocked_binding", "leader mode is not valid for this role")
    if role == "global-orchestrator":
        skill_policy_id = policy[f"{leader_mode}_skill_policy_id"]
        capabilities = policy[f"{leader_mode}_capabilities"]
    else:
        skill_policy_id = policy["skill_policy_id"]
        capabilities = policy["capabilities"]
    if not isinstance(skill_policy_id, str) or not isinstance(capabilities, list):
        raise PolicyError("blocked_role_schema", "role capability values are invalid")
    if any(not isinstance(item, str) for item in capabilities) or len(set(capabilities)) != len(capabilities):
        raise PolicyError("blocked_role_schema", "role capabilities are invalid")

    skill_path = manifest_path.with_name("skill-policies.toml")
    try:
        if skill_path.is_symlink() or not stat.S_ISREG(skill_path.lstat().st_mode):
            raise PolicyError("blocked_policy", "Skill policy manifest must be a regular file")
    except OSError as error:
        raise PolicyError("blocked_policy", "Skill policy manifest is unavailable") from error
    verify_manifest_schema(skill_path)
    skill_policy = load_restricted_section(
        skill_path,
        f"policies.{skill_policy_id}",
        {"version", "policy_id"},
        SKILL_POLICY_FIELDS - {"version", "policy_id"},
    )
    if set(skill_policy) != SKILL_POLICY_FIELDS:
        raise PolicyError("blocked_policy", "Skill policy is incomplete")
    if skill_policy["version"] != 1 or skill_policy["policy_id"] != skill_policy_id:
        raise PolicyError("blocked_policy", "Skill policy version or ID is invalid")
    for key in SKILL_POLICY_FIELDS - {"version", "policy_id"}:
        value = skill_policy[key]
        if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
            raise PolicyError("blocked_policy", "Skill policy list is invalid")
        if len(set(value)) != len(value):
            raise PolicyError("blocked_policy", "Skill policy contains duplicates")
    active_skills = sorted(
        (
            set(skill_policy["discovered_catalog"])
            & set(skill_policy["allow"])
            & set(skill_policy["task_overlay"])
        )
        - set(skill_policy["deny"])
    )
    if any(item.startswith(("http://", "https://", "plugin:network")) for item in active_skills):
        raise PolicyError("blocked_policy", "network Skill/plugin activation is forbidden")
    effective_capabilities = set(skill_policy["capabilities"]) - set(skill_policy["capability_deny"])
    if effective_capabilities != set(capabilities):
        raise PolicyError("blocked_role_schema", "role and Skill capabilities disagree")
    if skill_policy["status_hook_capabilities"] != ["observability"]:
        raise PolicyError("blocked_policy", "status hooks must be observability-only")
    if leader_mode in {"reviewer", "standby"}:
        denied = set(skill_policy["capability_deny"])
        if not {"dispatch", "multi-agent", "lease-write"} <= denied:
            raise PolicyError("blocked_policy", "reviewer/standby capability deny is incomplete")
        if {"dispatch", "multi-agent", "lease-write"} & effective_capabilities:
            raise PolicyError("blocked_policy", "reviewer/standby gained a forbidden capability")
    return {
        "leader_mode": leader_mode,
        "skill_policy_id": skill_policy_id,
        "active_skill_count": len(active_skills),
        "dispatch_allowed": "dispatch" in effective_capabilities,
        "lease_write_allowed": "lease-write" in effective_capabilities,
    }


def normalized_leader_scope(value: str) -> str:
    require_public_id(value, "leader scope")
    normalized = value.strip().lower()
    if value != normalized:
        raise PolicyError("blocked_binding", "leader scope must already be normalized")
    return normalized


def acquire_global_leader_lock(
    provider: str,
    scope: str,
    leader_id: str,
    proof_path_value: str | None,
) -> int:
    if proof_path_value is None:
        raise PolicyError("blocked_leader_conflict", "external lease proof is required")
    proof_path = Path(proof_path_value)
    if not proof_path.is_absolute():
        raise PolicyError("blocked_leader_conflict", "external lease proof path must be absolute")
    try:
        if proof_path.is_symlink() or not stat.S_ISREG(proof_path.lstat().st_mode):
            raise PolicyError("blocked_leader_conflict", "external lease proof must be a regular file")
        raw_proof = proof_path.read_bytes()
        seen_keys: set[str] = set()

        def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
            result: dict[str, object] = {}
            for key, value in pairs:
                if key in seen_keys:
                    raise ValueError("duplicate lease proof field")
                seen_keys.add(key)
                result[key] = value
            return result

        proof = json.loads(raw_proof, object_pairs_hook=reject_duplicate_keys)
    except PolicyError:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise PolicyError("blocked_leader_conflict", "external lease proof is invalid") from error
    fields = {
        "schema_version", "scope", "leader_id", "provider", "generation", "expires_at", "direct_parent"
    }
    if not isinstance(proof, dict) or set(proof) != fields:
        raise PolicyError("blocked_leader_conflict", "external lease proof schema is invalid")
    generation = proof.get("generation")
    expires_at = proof.get("expires_at")
    if (
        proof.get("schema_version") != 1
        or proof.get("scope") != scope
        or proof.get("leader_id") != leader_id
        or proof.get("provider") != provider
        or isinstance(generation, bool)
        or not isinstance(generation, int)
        or generation <= 0
        or isinstance(expires_at, bool)
        or not isinstance(expires_at, int)
        or expires_at <= int(time.time())
    ):
        raise PolicyError("blocked_leader_conflict", "external lease proof does not match")
    if proof.get("direct_parent") != "none":
        raise PolicyError("blocked_binding", "global leader takeover evidence is invalid")

    lock_root = Path(tempfile.gettempdir()) / f"ai-session-leader-locks-{os.getuid()}"
    try:
        lock_root.mkdir(mode=0o700, exist_ok=True)
        root_stat = lock_root.lstat()
        if lock_root.is_symlink() or not stat.S_ISDIR(root_stat.st_mode) or root_stat.st_uid != os.getuid():
            raise PolicyError("blocked_leader_conflict", "host-local lock directory is unsafe")
        os.chmod(lock_root, 0o700)
        lock_path = lock_root / f"{hashlib.sha256(scope.encode('utf-8')).hexdigest()}.lock"
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(lock_path, flags, 0o600)
        lock_stat = os.fstat(descriptor)
        if not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_uid != os.getuid():
            raise PolicyError("blocked_leader_conflict", "host-local lock file is unsafe")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise PolicyError("blocked_leader_conflict", "global leader scope is already active") from error
        metadata = json.dumps(
            {
                "generation": generation,
                "leader_id": leader_id,
                "pid": os.getpid(),
                "provider": provider,
                "start_time": int(time.time()),
            },
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8") + b"\n"
        os.ftruncate(descriptor, 0)
        os.write(descriptor, metadata)
        os.fsync(descriptor)
        os.set_inheritable(descriptor, True)
        return descriptor
    except PolicyError:
        if "descriptor" in locals():
            os.close(descriptor)
        raise
    except OSError as error:
        if "descriptor" in locals():
            os.close(descriptor)
        raise PolicyError("blocked_leader_conflict", "host-local leader lock failed") from error


def create_one_shot_capability(metadata: dict[str, object]) -> int:
    read_descriptor, write_descriptor = os.pipe()
    try:
        payload = json.dumps(
            {
                "schema_version": 1,
                "provider": metadata["provider"],
                "role_profile": metadata["role_profile"],
                "leader_mode": metadata["leader_mode"],
                "skill_policy_id": metadata["skill_policy_id"],
                "nonce": secrets.token_hex(32),
            },
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8") + b"\n"
        os.write(write_descriptor, payload)
    finally:
        os.close(write_descriptor)
    os.set_inheritable(read_descriptor, True)
    return read_descriptor


def consume_one_shot_capability(descriptor: int, metadata: dict[str, object]) -> None:
    try:
        payload_bytes = os.read(descriptor, 4097)
        exhausted = os.read(descriptor, 1)
    except OSError as error:
        raise PolicyError("blocked_binding", "one-shot role capability is unavailable") from error
    finally:
        try:
            os.close(descriptor)
        except OSError:
            pass
    try:
        payload = json.loads(payload_bytes)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise PolicyError("blocked_binding", "one-shot role capability is invalid") from error
    expected_fields = {
        "schema_version", "provider", "role_profile", "leader_mode", "skill_policy_id", "nonce"
    }
    if (
        exhausted
        or len(payload_bytes) > 4096
        or not isinstance(payload, dict)
        or set(payload) != expected_fields
        or payload.get("schema_version") != 1
        or payload.get("provider") != metadata.get("provider")
        or payload.get("role_profile") != metadata.get("role_profile")
        or payload.get("leader_mode") != metadata.get("leader_mode")
        or payload.get("skill_policy_id") != metadata.get("skill_policy_id")
        or not isinstance(payload.get("nonce"), str)
        or len(payload["nonce"]) != 64
    ):
        raise PolicyError("blocked_binding", "one-shot role capability is invalid")


def load_codex_policy(role: str) -> tuple[dict[str, object], Path]:
    manifest_path = role_manifest_path()
    try:
        if manifest_path.is_symlink() or not stat.S_ISREG(manifest_path.lstat().st_mode):
            raise PolicyError("blocked_policy", "role manifest must be a regular non-symlink file")
        policy = load_restricted_manifest_policy(manifest_path, role, "codex")
    except PolicyError:
        raise
    except (KeyError, OSError, TypeError, ValueError) as error:
        raise PolicyError("blocked_policy", "Codex role policy is unavailable") from error
    if not isinstance(policy, dict):
        raise PolicyError("blocked_policy", "Codex role policy is invalid")
    return policy, manifest_path.resolve().parents[2]


def repository_root(real_cwd: Path) -> Path:
    for candidate in (real_cwd, *real_cwd.parents):
        git_marker = candidate / ".git"
        if git_marker.exists() or git_marker.is_symlink():
            return candidate
    raise PolicyError("blocked_policy", "working directory is not in a Git repository")


def config_key_status(key: str) -> str:
    permission_terms = ("add_dir", "approval", "bypass", "danger", "permission", "sandbox")
    return "blocked_permission" if any(term in key.lower() for term in permission_terms) else "blocked_policy"


def validate_codex_config(value: object, prefix: tuple[str, ...] = ()) -> None:
    if not isinstance(value, dict):
        raise PolicyError("blocked_policy", "Codex project config must be a TOML table")
    if prefix and not value:
        raise PolicyError("blocked_policy", "empty Codex project config tables are not allowed")
    for name, child in value.items():
        key_parts = (*prefix, name)
        key = ".".join(key_parts)
        if isinstance(child, dict):
            validate_codex_config(child, key_parts)
            continue
        expected_type = BENIGN_CODEX_CONFIG_TYPES.get(key)
        if expected_type is None:
            raise PolicyError(config_key_status(key), f"Codex project config key is not allowed: {key}")
        if not isinstance(child, expected_type):
            raise PolicyError("blocked_policy", f"Codex project config value is invalid: {key}")
        if key == "tui.status_line" and not all(isinstance(item, str) for item in child):
            raise PolicyError("blocked_policy", f"Codex project config value is invalid: {key}")


def parse_restricted_codex_config(config_path: Path) -> dict[str, object]:
    try:
        lines = config_path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise PolicyError("blocked_policy", "Codex project config is invalid") from error
    config: dict[str, object] = {}
    section: tuple[str, ...] = ()
    seen_sections: set[tuple[str, ...]] = set()
    seen_keys: set[str] = set()
    for raw_line in lines:
        line = strip_toml_comment(raw_line).strip()
        if not line:
            continue
        section_match = re.fullmatch(r"\[([A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*)\]", line)
        if section_match is not None:
            section = tuple(section_match.group(1).split("."))
            if section in seen_sections:
                raise PolicyError("blocked_policy", "Codex project config repeats a table")
            seen_sections.add(section)
            continue
        assignment = re.fullmatch(
            r"([A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*)\s*=\s*(.+)",
            line,
        )
        if assignment is None:
            raise PolicyError("blocked_policy", "Codex project config is invalid")
        local_parts = tuple(assignment.group(1).split("."))
        key_parts = (*section, *local_parts)
        key = ".".join(key_parts)
        expected_type = BENIGN_CODEX_CONFIG_TYPES.get(key)
        if expected_type is None:
            raise PolicyError(config_key_status(key), f"Codex project config key is not allowed: {key}")
        if key in seen_keys:
            raise PolicyError("blocked_policy", "Codex project config repeats a key")
        seen_keys.add(key)
        encoded_value = assignment.group(2).strip()
        if expected_type is bool:
            if encoded_value not in {"true", "false"}:
                raise PolicyError("blocked_policy", f"Codex project config value is invalid: {key}")
            value: object = encoded_value == "true"
        else:
            try:
                value = ast.literal_eval(encoded_value)
            except (SyntaxError, ValueError) as error:
                raise PolicyError("blocked_policy", f"Codex project config value is invalid: {key}") from error
        target = config
        for part in key_parts[:-1]:
            child = target.setdefault(part, {})
            if not isinstance(child, dict):
                raise PolicyError("blocked_policy", "Codex project config is invalid")
            target = child
        target[key_parts[-1]] = value
    for table in seen_sections:
        target: object = config
        for part in table:
            if not isinstance(target, dict) or part not in target:
                raise PolicyError("blocked_policy", "empty Codex project config tables are not allowed")
            target = target[part]
    return config


def prescan_codex_configs(repository: Path, real_cwd: Path) -> None:
    relative_cwd = real_cwd.relative_to(repository)
    directories = [repository]
    for part in relative_cwd.parts:
        directories.append(directories[-1] / part)
    for directory in directories:
        config_directory = directory / ".codex"
        config_path = config_directory / "config.toml"
        if config_directory.is_symlink() or config_path.is_symlink():
            raise PolicyError("blocked_policy", "Codex project config chain contains a symlink")
        try:
            mode = config_path.lstat().st_mode
        except FileNotFoundError:
            continue
        except OSError as error:
            raise PolicyError("blocked_policy", "Codex project config cannot be inspected") from error
        if not stat.S_ISREG(mode):
            raise PolicyError("blocked_policy", "Codex project config must be a regular file")
        config = parse_restricted_codex_config(config_path)
        validate_codex_config(config)


def argument_name(argument: str) -> str:
    return argument.split("=", 1)[0]


def validate_codex_arguments(arguments: list[str]) -> None:
    for argument in arguments:
        name = argument_name(argument)
        if name in CODEX_PERMISSION_ARGUMENTS:
            raise PolicyError("blocked_permission", f"Codex permission override is not allowed: {name}")
        if name in CODEX_POLICY_ARGUMENTS:
            raise PolicyError("blocked_policy", f"Codex policy override is not allowed: {name}")


def parse_cli_version(output: str) -> tuple[int, int, int]:
    match = re.search(r"(?<![0-9])(\d+)\.(\d+)\.(\d+)(?![0-9])", output)
    if match is None:
        raise PolicyError("blocked_cli_contract", "provider CLI version is invalid")
    return tuple(int(part) for part in match.groups())


def parse_cli_range(value: object) -> tuple[tuple[int, int, int], tuple[int, int, int]]:
    if not isinstance(value, str):
        raise PolicyError("blocked_cli_contract", "provider CLI version range is invalid")
    match = re.fullmatch(
        r">=(\d+)\.(\d+)\.(\d+),<(\d+)\.(\d+)\.(\d+)", value
    )
    if match is None:
        raise PolicyError("blocked_cli_contract", "provider CLI version range is invalid")
    parts = tuple(int(part) for part in match.groups())
    return parts[:3], parts[3:]


def help_advertises(help_text: str, option: str) -> bool:
    return re.search(
        rf"(?<![A-Za-z0-9_-]){re.escape(option)}(?![A-Za-z0-9_-])",
        help_text,
    ) is not None


def verify_provider_cli_contract(provider: str, policy: dict[str, object]) -> None:
    expected = {
        "codex": {
            "range": ">=0.154.0,<0.155.0",
            "required": ["--model", "--sandbox", "--ask-for-approval"],
            "forbidden": ["--dangerously-bypass-approvals-and-sandbox", "--full-auto"],
        },
        "claude": {
            "range": ">=2.1.269,<2.2.0",
            "required": ["--append-system-prompt", "--settings", "--plugin-dir"],
            "forbidden": ["--append-system-prompt-file", "--plugin-url"],
        },
    }[provider]
    if (
        policy.get("cli_version_range") != expected["range"]
        or policy.get("cli_required_options") != expected["required"]
        or policy.get("cli_forbidden_options") != expected["forbidden"]
    ):
        raise PolicyError("blocked_cli_contract", "provider CLI policy is invalid")
    try:
        version_result = subprocess.run(
            [provider, "--version"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            check=False,
        )
        help_result = subprocess.run(
            [provider, "--help"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise PolicyError("blocked_cli_contract", "provider CLI probe failed") from error
    if version_result.returncode != 0 or help_result.returncode != 0:
        raise PolicyError("blocked_cli_contract", "provider CLI probe failed")
    version = parse_cli_version(version_result.stdout + version_result.stderr)
    lower, upper = parse_cli_range(policy["cli_version_range"])
    if not lower <= version < upper:
        raise PolicyError("blocked_cli_contract", "provider CLI version is unsupported")
    missing = [
        option
        for option in policy["cli_required_options"]
        if not help_advertises(help_result.stdout + help_result.stderr, option)
    ]
    if missing:
        raise PolicyError("blocked_cli_contract", "provider CLI required option is missing")


def load_claude_policy(role: str) -> tuple[dict[str, object], Path]:
    manifest_path = role_manifest_path()
    try:
        if manifest_path.is_symlink() or not stat.S_ISREG(manifest_path.lstat().st_mode):
            raise PolicyError("blocked_policy", "role manifest must be a regular non-symlink file")
        policy = load_restricted_manifest_policy(manifest_path, role, "claude")
    except PolicyError:
        raise
    except (KeyError, OSError, TypeError, ValueError) as error:
        raise PolicyError("blocked_policy", "Claude role policy is unavailable") from error
    if not isinstance(policy, dict):
        raise PolicyError("blocked_policy", "Claude role policy is invalid")
    return policy, manifest_path.resolve().parents[2]


def regular_file_bytes(path: Path, description: str) -> bytes:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise PolicyError("blocked_policy", f"{description} must be a regular non-symlink file") from error
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise PolicyError("blocked_policy", f"{description} must be a regular non-symlink file")
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            return stream.read()
    finally:
        os.close(descriptor)


def parse_json_object(data: bytes, description: str) -> dict[str, object]:
    def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate key")
            result[key] = value
        return result

    try:
        value = json.loads(data.decode("utf-8"), object_pairs_hook=reject_duplicate_keys)
    except (UnicodeError, ValueError) as error:
        raise PolicyError("blocked_policy", f"{description} is invalid JSON") from error
    if not isinstance(value, dict):
        raise PolicyError("blocked_policy", f"{description} must be a JSON object")
    return value


def layout_relative_path(project_root: Path, relative: Path) -> Path:
    source_manifest = project_root / "dot_config/ai-session/roles.toml"
    if source_manifest.is_file():
        if relative.parts[:1] == (".config",):
            return project_root / "dot_config" / Path(*relative.parts[1:])
        if relative.parts[:1] == (".claude",):
            return project_root / "dot_claude" / Path(*relative.parts[1:])
    return project_root / relative


def trusted_relative_path(project_root: Path, encoded: object, description: str) -> Path:
    if not isinstance(encoded, str):
        raise PolicyError("blocked_policy", f"{description} path is invalid")
    relative = Path(encoded)
    if relative.is_absolute():
        raise PolicyError("blocked_policy", f"{description} path must be project-relative")
    path = layout_relative_path(project_root, relative)
    try:
        resolved = path.resolve(strict=True)
        resolved.relative_to(project_root)
    except (OSError, ValueError) as error:
        raise PolicyError("blocked_policy", f"{description} path escapes the reviewed project") from error
    if path.is_symlink():
        raise PolicyError("blocked_policy", f"{description} path must not be a symlink")
    return resolved


def load_digest_verified_json(
    project_root: Path, encoded_path: object, expected_digest: object, description: str
) -> tuple[Path, dict[str, object]]:
    path = trusted_relative_path(project_root, encoded_path, description)
    data = regular_file_bytes(path, description)
    if not isinstance(expected_digest, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_digest):
        raise PolicyError("blocked_policy", f"{description} digest is invalid")
    if hashlib.sha256(data).hexdigest() != expected_digest:
        raise PolicyError("blocked_policy", f"{description} digest mismatch")
    return path, parse_json_object(data, description)


def load_reviewed_instruction(
    project_root: Path, policy: dict[str, object]
) -> tuple[str, int, str]:
    if policy.get("instruction_version") != 1:
        raise PolicyError("blocked_policy", "reviewed instruction version is unsupported")
    path = trusted_relative_path(
        project_root, policy.get("instruction_path"), "reviewed instruction"
    )
    data = regular_file_bytes(path, "reviewed instruction")
    digest = policy.get("instruction_sha256")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise PolicyError("blocked_policy", "reviewed instruction digest is invalid")
    if hashlib.sha256(data).hexdigest() != digest:
        raise PolicyError("blocked_policy", "reviewed instruction digest mismatch")
    if b"\0" in data:
        raise PolicyError("blocked_policy", "reviewed instruction contains NUL")
    try:
        value = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise PolicyError("blocked_policy", "reviewed instruction is not UTF-8") from error
    return value, 1, digest


def validate_composed_settings(composed: dict[str, object], policy: dict[str, object]) -> None:
    if policy.get("settings_version") != 1:
        raise PolicyError("blocked_policy", "Claude settings version is unsupported")
    composed_permissions = composed.get("permissions")
    common_permissions = (
        {**composed_permissions, "deny": []}
        if isinstance(composed_permissions, dict)
        else composed_permissions
    )
    common = {
        "permissions": common_permissions,
        "sandbox": composed.get("sandbox"),
        "hooks": composed.get("hooks"),
    }
    common_digest = hashlib.sha256(
        json.dumps(
            common,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        ).encode("utf-8")
    ).hexdigest()
    if policy.get("common_settings_sha256") != common_digest:
        raise PolicyError("blocked_policy", "Claude common settings digest mismatch")
    if set(common) != {"permissions", "sandbox", "hooks"}:
        raise PolicyError("blocked_policy", "Claude common settings contain an unreviewed key")
    if set(composed) != {*common, "model", "effortLevel"}:
        raise PolicyError("blocked_policy", "Claude composed settings contain an unreviewed key")
    if composed.get("hooks") != common.get("hooks") or composed.get("sandbox") != common.get("sandbox"):
        raise PolicyError("blocked_policy", "Claude common settings composition mismatch")
    common_permissions = common.get("permissions")
    permissions = composed.get("permissions")
    if not isinstance(common_permissions, dict) or not isinstance(permissions, dict):
        raise PolicyError("blocked_policy", "Claude permissions are invalid")
    denied = policy.get("denied_permissions")
    if not isinstance(denied, list) or not all(isinstance(item, str) for item in denied):
        raise PolicyError("blocked_policy", "Claude role deny policy is invalid")
    if permissions.get("allow") != common_permissions.get("allow"):
        raise PolicyError("blocked_policy", "Claude common allow policy composition mismatch")
    if permissions.get("deny") != denied:
        raise PolicyError("blocked_policy", "Claude role deny policy composition mismatch")
    allowed = permissions.get("allow")
    if not isinstance(allowed, list) or set(allowed) & set(denied):
        raise PolicyError("blocked_policy", "Claude role deny conflicts with the common allow policy")
    if permissions.get("defaultMode") != "dontAsk":
        raise PolicyError("blocked_policy", "Claude default permission mode must be dontAsk")
    sandbox = composed.get("sandbox")
    if not isinstance(sandbox, dict) or sandbox.get("enabled") is not True:
        raise PolicyError("blocked_policy", "Claude sandbox must fail closed")
    if sandbox.get("autoAllowBashIfSandboxed") is not False:
        raise PolicyError("blocked_policy", "Claude sandbox may not auto-allow commands")
    model = policy.get("model")
    effort = policy.get("elevated_effort", policy.get("effort"))
    if composed.get("model") != model or composed.get("effortLevel") != effort:
        raise PolicyError("blocked_policy", "Claude composed model or effort mismatch")


def validate_untrusted_claude_settings(path: Path) -> None:
    data = regular_file_bytes(path, "untrusted Claude settings")
    value = parse_json_object(data, "untrusted Claude settings")
    for key, setting in value.items():
        expected_type = BENIGN_CLAUDE_SETTING_TYPES.get(key)
        if expected_type is None or not isinstance(setting, expected_type):
            raise PolicyError("blocked_policy", f"untrusted Claude settings key is not allowed: {key}")


def validate_untrusted_claude_candidates(candidates: tuple[Path, ...]) -> None:
    for path in candidates:
        try:
            path.lstat()
        except FileNotFoundError:
            continue
        except OSError as error:
            raise PolicyError("blocked_policy", "untrusted Claude settings cannot be inspected") from error
        validate_untrusted_claude_settings(path)


def prescan_claude_settings(repository: Path) -> None:
    validate_untrusted_claude_candidates(
        (
            repository / ".claude/settings.json",
            repository / ".claude/settings.local.json",
        )
    )


def prescan_selected_claude_home() -> None:
    encoded_home = os.environ.get("CLAUDE_CONFIG_DIR")
    home_path = Path(encoded_home) if encoded_home else Path.home() / ".claude"
    if not home_path.is_absolute():
        raise PolicyError("blocked_policy", "selected Claude config home must be absolute")
    validate_untrusted_claude_candidates(
        (home_path / "settings.json", home_path / "settings.local.json")
    )


def validate_claude_arguments(arguments: list[str]) -> None:
    for argument in arguments:
        name = argument_name(argument)
        if name in CLAUDE_POLICY_ARGUMENTS:
            raise PolicyError("blocked_policy", f"Claude policy override is not allowed: {name}")


def claude_command(role: str, arguments: list[str]) -> tuple[list[str], dict[str, object]]:
    policy, project_root = load_claude_policy(role)
    verify_provider_cli_contract("claude", policy)
    real_cwd = Path.cwd().resolve(strict=True)
    repository = repository_root(real_cwd).resolve(strict=True)
    prescan_claude_settings(repository)
    validate_claude_arguments(arguments)
    settings_path, composed = load_digest_verified_json(
        project_root,
        policy.get("settings_path"),
        policy.get("settings_sha256"),
        "Claude composed settings",
    )
    validate_composed_settings(composed, policy)
    instruction, instruction_version, instruction_sha256 = load_reviewed_instruction(
        project_root, policy
    )
    plugin_dirs = policy.get("plugin_dirs")
    if not isinstance(plugin_dirs, list) or not plugin_dirs:
        raise PolicyError("blocked_policy", "Claude reviewed local plugin policy is missing")
    plugin_arguments: list[str] = []
    for encoded_path in plugin_dirs:
        plugin_path = trusted_relative_path(project_root, encoded_path, "Claude plugin")
        try:
            mode = plugin_path.lstat().st_mode
        except OSError as error:
            raise PolicyError("blocked_policy", "Claude plugin cannot be inspected") from error
        if not stat.S_ISDIR(mode):
            raise PolicyError("blocked_policy", "Claude plugin must be a local directory")
        plugin_arguments.extend(("--plugin-dir", str(plugin_path)))
    try:
        model = str(policy["model"])
        effort = str(policy.get("elevated_effort", policy["effort"]))
    except KeyError as error:
        raise PolicyError("blocked_policy", "Claude role policy is incomplete") from error
    command = [
        "claude",
        "--model",
        model,
        "--effort",
        effort,
        "--settings",
        str(settings_path),
        "--setting-sources",
        "",
        *plugin_arguments,
        "--append-system-prompt",
        instruction,
        *arguments,
    ]
    return command, {
        "cwd": str(real_cwd),
        "repository": str(repository),
        "provider": "claude",
        "model": model,
        "effort": effort,
        "settings_id": policy["settings_sha256"],
        "permission_engine": "claude-settings",
        "permission_mode": "dontAsk",
        "instruction_version": instruction_version,
        "instruction_sha256": instruction_sha256,
    }


def codex_command(role: str, arguments: list[str]) -> tuple[list[str], dict[str, object]]:
    policy, project_root = load_codex_policy(role)
    verify_provider_cli_contract("codex", policy)
    real_cwd = Path.cwd().resolve(strict=True)
    work_root = repository_root(real_cwd).resolve(strict=True)
    prescan_codex_configs(work_root, real_cwd)
    validate_codex_arguments(arguments)
    try:
        model = policy["model"]
        effort = policy["effort"]
        approval = policy["approval"]
        sandbox = policy["sandbox"]
    except KeyError as error:
        raise PolicyError("blocked_policy", "Codex role policy is incomplete") from error
    instructions, instruction_version, instruction_sha256 = load_reviewed_instruction(
        project_root, policy
    )
    command = [
        "codex",
        "--model",
        str(model),
        "-c",
        f'model_reasoning_effort="{effort}"',
        "--ask-for-approval",
        str(approval),
        "--sandbox",
        str(sandbox),
        "-C",
        str(work_root),
        "-c",
        f'developer_instructions="{instructions}"',
        *arguments,
    ]
    return command, {
        "cwd": str(real_cwd),
        "repository": str(work_root),
        "provider": "codex",
        "model": str(model),
        "effort": str(effort),
        "settings_id": None,
        "permission_engine": str(policy.get("permission_generation", "legacy")),
        "permission_mode": str(sandbox),
        "instruction_version": instruction_version,
        "instruction_sha256": instruction_sha256,
    }


def write_public_record(record: dict[str, object]) -> None:
    encoded = json.dumps(
        record, ensure_ascii=False, separators=(",", ":"), sort_keys=True
    ).encode("utf-8") + b"\n"
    os.write(2, encoded)


def failure_exit_code(status: str) -> int:
    return 2 if status == "blocked_contract" else 4


def failure_record(
    status: str,
    provider: str | None,
    role: str | None,
    exit_code: int | None = None,
) -> dict[str, object]:
    if exit_code is None:
        exit_code = failure_exit_code(status)
    return {
        "schema_version": 1,
        "event": "launch_failure",
        "status": status,
        "exit_code": exit_code,
        "provider": provider,
        "role_profile": role,
        "account_profile": os.environ.get("AI_ACCOUNT_PROFILE"),
        "account_scope": os.environ.get("AI_ACCOUNT_SCOPE"),
        "selection_source": os.environ.get("AI_SELECTION_SOURCE"),
        "selection_reason": os.environ.get("AI_SELECTION_REASON"),
        "usage_admission_status": os.environ.get("AI_USAGE_ADMISSION_STATUS"),
    }


def require_public_id(value: str, field: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]*", value):
        raise PolicyError("blocked_binding", f"{field} is invalid")
    return value


def parse_launcher_arguments(arguments: list[str]) -> tuple[dict[str, str], list[str]]:
    forbidden = {"--continue", "--resume", "--session-id"}
    for argument in arguments:
        if argument_name(argument) in forbidden:
            raise PolicyError("blocked_binding", "resume, continue and session ID inputs are forbidden")
    options: dict[str, str] = {}
    value_options = {
        "--account-profile",
        "--binding-file",
        "--cost-limit-usd",
        "--directory",
        "--leader-id",
        "--leader-mode",
        "--leader-scope",
        "--lease-proof",
        "--organization",
        "--parent-task-id",
        "--registry",
        "--repository",
        "--task-id",
        "--verifier",
    }
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--":
            return options, arguments[index + 1 :]
        if argument not in value_options:
            return options, arguments[index:]
        if index + 1 >= len(arguments):
            raise PolicyError("blocked_binding", f"{argument} requires a value")
        options[argument] = arguments[index + 1]
        index += 2
    return options, []


def dispatch_move_rebind(provider: str, arguments: list[str]) -> int:
    value_options = {
        "--account-profile",
        "--binding-id",
        "--binding-kind",
        "--common-dir-policy",
        "--handoff",
        "--new-worktree",
        "--old-worktree",
        "--registry",
        "--result",
        "--shutdown-proof",
    }
    forwarded: list[str] = []
    seen: set[str] = set()
    index = 0
    while index < len(arguments):
        option = arguments[index]
        if option not in value_options or option in seen or index + 1 >= len(arguments):
            raise PolicyError("blocked_binding", "move-rebind inputs are invalid")
        seen.add(option)
        forwarded.extend((option, arguments[index + 1]))
        index += 2
    required = value_options - {"--shutdown-proof"}
    if not required.issubset(seen):
        raise PolicyError("blocked_binding", "move-rebind inputs are incomplete")
    command = [
        "ai-session",
        "move-rebind",
        "--provider",
        provider,
        "--role-contract",
        ROLE_CONTRACT_ID,
        *forwarded,
    ]
    try:
        os.execvpe(command[0], command, os.environ.copy())
    except OSError:
        write_public_record(failure_record("blocked_cli_contract", provider, None))
        return 4


def task_parent_values(role: str, options: dict[str, str]) -> tuple[str, str]:
    task_id = options.get("--task-id")
    parent_id = options.get("--parent-task-id")
    if role == "general":
        if task_id is not None or parent_id is not None:
            raise PolicyError("blocked_binding", "general role must be unbound")
        return "unbound", "unbound"
    if role == "orchestrator":
        if task_id is None:
            raise PolicyError("blocked_binding", "orchestrator task ID is required")
        task_id = require_public_id(task_id, "task ID")
        if parent_id is None:
            parent_id = "none"
        if parent_id != "none":
            parent_id = require_public_id(parent_id, "direct parent ID")
        if parent_id == task_id:
            raise PolicyError("blocked_binding", "task cannot be its own parent")
        return task_id, parent_id
    if role == "feature-orchestrator":
        if task_id is None or parent_id is None or parent_id == "none":
            raise PolicyError("blocked_binding", "feature task and direct parent are required")
        task_id = require_public_id(task_id, "task ID")
        parent_id = require_public_id(parent_id, "direct parent ID")
        if parent_id == task_id:
            raise PolicyError("blocked_binding", "task cannot be its own parent")
        return task_id, parent_id
    if task_id is not None or parent_id not in {None, "none"}:
        raise PolicyError("blocked_binding", "global role must have parent none")
    return "unbound", "none"


def admitted_main(arguments: list[str]) -> int:
    if os.environ.get("AI_ROLE_ADMITTED") != "1":
        write_public_record(failure_record("blocked_contract", None, None))
        return failure_exit_code("blocked_contract")
    try:
        capability_descriptor = None
        if arguments and arguments[0] == "--capability-fd":
            if len(arguments) < 5 or arguments[3] != "--":
                raise ValueError("capability arguments are invalid")
            capability_descriptor = int(arguments[1])
            metadata_index = 2
            separator_index = 3
        else:
            if len(arguments) < 3 or arguments[1] != "--":
                raise ValueError("admitted arguments are invalid")
            metadata_index = 0
            separator_index = 1
        metadata = json.loads(arguments[metadata_index])
        if not isinstance(metadata, dict):
            raise ValueError("metadata is not an object")
        command = arguments[separator_index + 1:]
        if not command:
            raise ValueError("provider command is missing")
        if metadata.get("dispatch_allowed") is True:
            if capability_descriptor is None:
                raise ValueError("dispatch capability is missing")
            consume_one_shot_capability(capability_descriptor, metadata)
        elif capability_descriptor is not None:
            raise ValueError("non-dispatch role received a capability")
        generation = int(os.environ["AI_BINDING_GENERATION"])
        if generation <= 0:
            raise ValueError("binding generation is invalid")
        if metadata.get("provider") == "claude":
            prescan_selected_claude_home()
        startup = {
            **metadata,
            "schema_version": 1,
            "event": "role_startup",
            "manifest_id": ROLE_CONTRACT_ID,
            "account_profile": os.environ["AI_ACCOUNT_PROFILE"],
            "account_scope": os.environ["AI_ACCOUNT_SCOPE"],
            "selection_source": os.environ["AI_SELECTION_SOURCE"],
            "selection_reason": os.environ["AI_SELECTION_REASON"],
            "usage_admission_status": os.environ["AI_USAGE_ADMISSION_STATUS"],
            "binding_generation": generation,
        }
    except PolicyError as error:
        write_public_record(failure_record(error.status, None, None))
        return failure_exit_code(error.status)
    except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
        write_public_record(failure_record("blocked_contract", None, None))
        return failure_exit_code("blocked_contract")
    write_public_record(startup)
    environment = os.environ.copy()
    environment.pop("AI_ROLE_ADMITTED", None)
    try:
        os.execvpe(command[0], command, environment)
    except OSError:
        write_public_record(
            failure_record(
                "blocked_cli_contract",
                str(metadata.get("provider")) if metadata.get("provider") else None,
                str(metadata.get("role_profile")) if metadata.get("role_profile") else None,
            )
        )
        return 4


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--admitted":
        return admitted_main(sys.argv[2:])
    for internal_name in (
        "AI_ROLE_ADMITTED",
        "AI_ACCOUNT_PROFILE",
        "AI_ACCOUNT_SCOPE",
        "AI_SELECTION_SOURCE",
        "AI_SELECTION_REASON",
        "AI_USAGE_ADMISSION_STATUS",
        "AI_BINDING_GENERATION",
        "AI_SESSION_GIT_COMMON_DIR_RELATION",
        "AI_SESSION_WRITE_ALLOW_SET",
    ):
        os.environ.pop(internal_name, None)
    entrypoint = Path(sys.argv[0]).name
    dispatch = ENTRYPOINTS.get(entrypoint)
    if dispatch is None:
        write_public_record(failure_record("blocked_role_schema", None, None))
        return 4

    provider, role = dispatch
    if len(sys.argv) > 1 and sys.argv[1] == "move-rebind":
        try:
            return dispatch_move_rebind(provider, sys.argv[2:])
        except PolicyError as error:
            write_public_record(failure_record(error.status, provider, role))
            return 4
    try:
        options, provider_arguments = parse_launcher_arguments(sys.argv[1:])
        task_id, direct_parent_id = task_parent_values(role, options)
        capability_policy = load_role_capability_policy(role, options.get("--leader-mode"))
        leader_mode = str(capability_policy["leader_mode"])
        leader_scope = options.get("--leader-scope")
        leader_id = options.get("--leader-id")
        if role == "global-orchestrator":
            if leader_scope is not None:
                leader_scope = normalized_leader_scope(leader_scope)
            if leader_id is not None:
                leader_id = require_public_id(leader_id, "leader ID")
            if leader_mode == "active" and (leader_scope is None or leader_id is None):
                raise PolicyError("blocked_binding", "active global leader scope and ID are required")
        elif any(
            option in options
            for option in ("--leader-id", "--leader-scope", "--lease-proof")
        ):
            raise PolicyError("blocked_binding", "leader inputs are only valid for the global role")
        provider_command, metadata = (
            codex_command(role, provider_arguments)
            if provider == "codex"
            else claude_command(role, provider_arguments)
        )
        metadata.update(
            {
                "role_profile": role,
                "task_id": task_id,
                "direct_parent_id": direct_parent_id,
                **capability_policy,
            }
        )
        lock_descriptor = None
        if role == "global-orchestrator" and leader_mode == "active":
            lock_descriptor = acquire_global_leader_lock(
                provider,
                str(leader_scope),
                str(leader_id),
                options.get("--lease-proof"),
            )
        capability_descriptor = (
            create_one_shot_capability(metadata)
            if metadata["dispatch_allowed"] is True
            else None
        )
    except (OSError, PolicyError) as error:
        status = error.status if isinstance(error, PolicyError) else "blocked_policy"
        write_public_record(failure_record(status, provider, role))
        return failure_exit_code(status)
    project_root = role_manifest_path().resolve().parents[2]
    forwarded = []
    for option in (
        "--account-profile",
        "--binding-file",
        "--cost-limit-usd",
        "--directory",
        "--organization",
        "--registry",
        "--repository",
        "--task-id",
        "--verifier",
    ):
        if option in options:
            forwarded.extend((option, options[option]))
    if "--registry" not in options:
        forwarded.extend(
            (
                "--registry",
                str(
                    trusted_relative_path(
                        project_root,
                        ".config/ai-session/accounts.toml",
                        "account registry",
                    )
                ),
            )
        )
    if "--verifier" not in options:
        forwarded.extend(("--verifier", str(Path.home() / f".local/libexec/ai-session-verify-{provider}")))
    admitted_command = [
        str(Path(__file__).resolve()),
        "--admitted",
        *(
            ["--capability-fd", str(capability_descriptor)]
            if capability_descriptor is not None
            else []
        ),
        json.dumps(metadata, ensure_ascii=False, separators=(",", ":"), sort_keys=True),
        "--",
        *provider_command,
    ]
    command = [
        "ai-session",
        "launch",
        "--provider",
        provider,
        "--role-profile",
        role,
        "--role-contract",
        ROLE_CONTRACT_ID,
        "--write-need",
        (
            "none"
            if role == "global-orchestrator" and leader_mode in {"reviewer", "standby"}
            else "git"
        ),
        *forwarded,
        "--",
        *admitted_command,
    ]
    environment = os.environ.copy()
    environment["AI_ROLE_ADMITTED"] = "1"
    try:
        os.execvpe(command[0], command, environment)
    except OSError:
        write_public_record(failure_record("blocked_cli_contract", provider, role))
        return 4


if __name__ == "__main__":
    raise SystemExit(main())
