#!/usr/bin/env bash
# 구 이름 tmux 세션을 `{순번}-{이름}` 규칙으로 옮긴다.
#
#   main → 1-main   review → 2-review   personal → 3-personal
#   eslint → 4-eslint   quick → 5-quick
#
# 왜 필요한가: `.zshrc`는 `tmux new-session -A -s 1-main`으로 붙는데 `-A`는 이름이
# 정확히 일치할 때만 붙는다. 구 이름 세션이 살아 있으면 붙지 않고 빈 `1-main`을
# 새로 만들어, 기존 작업이 구 이름 세션에 남은 채로 화면에는 아무 경고가 없다.
# resurrect 스냅샷도 구 이름을 담고 있으면 복원 때마다 이 분리가 재생산된다.
#
# 세션명은 세 곳에 저장된다. 하나만 고치면 나머지가 어긋난다.
#   1. tmux 서버의 실제 세션명
#   2. workmux agent state (~/.local/state/workmux/agents/*.json 의 session_name)
#      — 윈도우 탭의 에이전트 표시, `prefix + G`의 last-done, dashboard의 근거
#   3. 저장소별 git config (workmux.worktree.{이름}.window-session)
#      — workmux 가 close/remove/open 에서 윈도우를 찾는 근거
#
# 개명은 비파괴적이다. 대상 이름이 이미 있으면 임시 이름을 거쳐 클라이언트와
# 윈도우를 합친다 — kill-session 은 쓰지 않는다. 붙어 있는 클라이언트를 detach
# 시키면 `.zshrc`가 `exec tmux`를 하므로 그 터미널 창이 닫히기 때문이다.
#
# 사용법:
#   tmux-migrate-session-names [--dry-run] [저장소경로...]
#
#   --dry-run   아무것도 바꾸지 않고 할 일만 출력한다.
#   저장소경로   git config 를 고칠 저장소. 생략하면 현재 디렉터리가 git 저장소일
#               때 그것만 대상으로 한다. worktree 들은 .git/config 를 공유하므로
#               저장소마다 한 번이면 된다.
#
# 종료 코드: 0 = 모두 정상, 1 = 하나 이상 실패했거나 규칙 밖 값이 남았다.

set -u

DRY_RUN=0
REPOS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        -h|--help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "알 수 없는 옵션: $1" >&2; exit 2 ;;
        *) REPOS+=("$1") ;;
    esac
    shift
done

# 구 이름 → 새 이름. 연관 배열은 bash 3.2(macOS 기본)에 없으므로 쓰지 않는다.
LEGACY_PAIRS='main:1-main review:2-review personal:3-personal eslint:4-eslint quick:5-quick'
RULE_RE='^[0-9]+-.+$'

rc=0
fail() { echo "  ✗ $*" >&2; rc=1; }
ok()   { echo "  ✓ $*"; }
skip() { echo "  · $*"; }

state_dir="$HOME/.local/state/workmux/agents"

# 가드 값. 서버가 없으면 빈 문자열이 되고, 그때는 state 를 건드리지 않는다.
#   instance — 다른 tmux 서버의 state 를 건드리지 않는다
#   boot_id  — 이전 부팅 state 는 `workmux resurrect` 의 입력이다. 지우거나 고치면
#              복구가 불가능해진다. 2단계에서 건너뛰고 4단계에서도 실패로 세지 않는다.
sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)
boot=$(tmux display-message -p '#{start_time}' 2>/dev/null || true)

run() {
    if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] $*"
        return 0
    fi
    "$@"
}

new_name_for() {
    # 구 이름 하나를 받아 새 이름을 출력한다. 매핑에 없으면 아무것도 출력하지 않는다.
    local want="$1" pair
    for pair in $LEGACY_PAIRS; do
        [ "${pair%%:*}" = "$want" ] && { printf '%s' "${pair#*:}"; return 0; }
    done
    return 1
}

session_exists() {
    # 정확 매칭. tmux 타깃은 접두사 매칭을 하므로 has-session 을 쓰면 안 된다
    # (`1-maintenance` 만 있어도 `has-session -t 1-main` 이 exit 0 을 낸다).
    tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF -- "$1"
}

# ------------------------------------------------------------------
# 1. tmux 세션
# ------------------------------------------------------------------
echo "1. tmux 세션"

if ! tmux list-sessions >/dev/null 2>&1; then
    skip "tmux 서버가 없다 — 세션 개명은 건너뛴다"
    skip "  서버가 뜬 뒤(구 이름이 복원된 뒤) 다시 실행하라"
else
    for pair in $LEGACY_PAIRS; do
        old="${pair%%:*}"
        new="${pair#*:}"

        session_exists "$old" || continue

        if ! session_exists "$new"; then
            if run tmux rename-session -t "$old" "$new"; then
                ok "$old → $new"
            else
                fail "$old → $new 개명 실패"
            fi
            continue
        fi

        # 대상 이름이 이미 있다 — 비파괴적으로 합친다.
        echo "  $old 과 $new 가 모두 있다 — 합친다 (kill 하지 않는다)"
        tmp="0-migrating-$$"

        if ! run tmux rename-session -t "$new" "$tmp"; then
            fail "$new → $tmp 임시 개명 실패 — $old 를 건드리지 않았다"
            continue
        fi
        if ! run tmux rename-session -t "$old" "$new"; then
            fail "$old → $new 개명 실패 — $tmp 를 되돌린다"
            run tmux rename-session -t "$tmp" "$new" || fail "$tmp → $new 복구도 실패했다"
            continue
        fi

        merged=1

        # 임시 세션에 붙어 있던 클라이언트를 새 이름으로 옮긴다 (detach 없이).
        if [ "$DRY_RUN" = 0 ]; then
            while read -r tty; do
                [ -n "$tty" ] || continue
                tmux switch-client -c "$tty" -t "$new" \
                    || { fail "클라이언트 $tty 를 $new 로 옮기지 못했다"; merged=0; }
            done < <(tmux list-clients -t "$tmp" -F '#{client_tty}' 2>/dev/null)
        else
            echo "  [dry-run] $tmp 의 클라이언트를 $new 로 switch-client"
        fi

        # 남은 윈도우를 옮긴다. 마지막 윈도우가 빠지면 임시 세션은 스스로 사라진다.
        if [ "$DRY_RUN" = 0 ]; then
            while read -r widx; do
                [ -n "$widx" ] || continue
                tmux move-window -s "$tmp:$widx" -t "$new:" \
                    || { fail "$tmp:$widx 를 $new 로 옮기지 못했다"; merged=0; }
            done < <(tmux list-windows -t "$tmp" -F '#{window_index}' 2>/dev/null)
        else
            echo "  [dry-run] $tmp 의 윈도우를 $new 로 move-window"
        fi

        # 임시 세션을 지우지 않는다. 윈도우를 다 옮겼으면 tmux 가 스스로 없애므로
        # 남아 있다는 것은 **옮기지 못한 창이 있다**는 뜻이다. 그걸 kill-session 하면
        # 실행 중인 프로세스가 죽고 붙어 있는 클라이언트가 detach된다 — 이 스크립트가
        # 애초에 피하려던 바로 그 파괴다.
        if [ "$DRY_RUN" = 0 ] && session_exists "$tmp"; then
            fail "임시 세션 $tmp 가 남았다 — 옮기지 못한 창이 있다. 지우지 않았으니 직접 확인하라"
            fail "  남은 창: $(tmux list-windows -t "$tmp" -F '#{window_index}:#{window_name}' 2>/dev/null | tr '\n' ' ')"
            merged=0
        fi

        if [ "$merged" = 1 ]; then
            ok "$old → $new (합침 완료)"
        else
            fail "$old → $new 병합이 완료되지 않았다 — 위 항목을 먼저 처리하라"
        fi
    done
fi

# ------------------------------------------------------------------
# 2. workmux agent state
# ------------------------------------------------------------------
echo "2. workmux agent state"

if ! command -v jq >/dev/null 2>&1; then
    fail "jq 가 없다 — agent state 를 갱신할 수 없다 (brew install jq / apt install jq)"
elif [ ! -d "$state_dir" ]; then
    skip "$state_dir 가 없다 — 갱신할 state 가 없다"
else
    if [ -z "$sock" ] || [ -z "$boot" ]; then
        skip "tmux 서버가 없어 instance·boot_id 가드 값을 읽을 수 없다 — 건너뛴다"
    else
        touched=0
        for f in "$state_dir"/tmux__*.json; do
            [ -e "$f" ] || continue
            [ "$(jq -r '.pane_key.instance // ""' "$f" 2>/dev/null)" = "$sock" ] || continue
            [ "$(jq -r '.boot_id // ""' "$f" 2>/dev/null)" = "$boot" ] || continue

            old=$(jq -r '.session_name // ""' "$f" 2>/dev/null)
            new=$(new_name_for "$old") || continue

            if [ "$DRY_RUN" = 1 ]; then
                echo "  [dry-run] $(basename "$f") $old → $new"
                touched=$((touched + 1))
                continue
            fi

            if jq --arg s "$new" '.session_name = $s' "$f" > "$f.tmp" 2>/dev/null \
                && mv -- "$f.tmp" "$f"; then
                ok "$(basename "$f") $old → $new"
                touched=$((touched + 1))
            else
                rm -f -- "$f.tmp"
                fail "$f 갱신 실패 ($old → $new)"
            fi
        done
        [ "$touched" -gt 0 ] || skip "구 이름을 담은 state 가 없다"
    fi
fi

# ------------------------------------------------------------------
# 3. 저장소별 git config
# ------------------------------------------------------------------
echo "3. workmux git config"

if [ "${#REPOS[@]}" -eq 0 ]; then
    if git rev-parse --git-dir >/dev/null 2>&1; then
        REPOS=(".")
    else
        skip "대상 저장소가 없다 (인수 없음, 현재 디렉터리도 git 저장소가 아니다)"
    fi
fi

for repo in ${REPOS[@]+"${REPOS[@]}"}; do
    if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
        fail "$repo 는 git 저장소가 아니다"
        continue
    fi

    changed=0
    while read -r key value; do
        [ -n "$key" ] || continue
        new=$(new_name_for "$value") || {
            # 매핑에 없다. 규칙에 맞는 값이면 의도적으로 옮긴 것이니 그대로 둔다.
            printf '%s' "$value" | grep -qE "$RULE_RE" \
                || fail "$repo: $key = $value — 매핑에 없는 규칙 밖 값이다. 직접 정하라"
            continue
        }

        if [ "$DRY_RUN" = 1 ]; then
            echo "  [dry-run] $repo: $key $value → $new"
            changed=$((changed + 1))
            continue
        fi

        if git -C "$repo" config "$key" "$new"; then
            ok "$repo: $key $value → $new"
            changed=$((changed + 1))
        else
            fail "$repo: $key 갱신 실패 ($value → $new)"
        fi
    done < <(git -C "$repo" config --get-regexp '^workmux\.worktree\..*\.window-session' 2>/dev/null)

    [ "$changed" -gt 0 ] || skip "$repo: 고칠 값이 없다"
done

# ------------------------------------------------------------------
# 4. 재검증 — 규칙 밖 값이 남아 있는지
# ------------------------------------------------------------------
echo "4. 재검증"

# dry-run 에서도 돌린다. 건너뛰면 `scratch` 처럼 매핑에 없는 규칙 밖 값이 사전
# 점검에서 보고되지 않고 exit 0 이 나온다. 그걸 믿고 실제 실행하면 세션·state·git
# config 를 먼저 바꾼 뒤에야 같은 값에서 실패해 부분 이관 상태가 된다.
#
# 알려진 레거시 값은 dry-run 에서 "적용 예정"으로 투영한다. 실제 실행에서 같은 값이
# 남아 있다면 이관이 실제로 안 된 것이므로 그때는 실패다.
check_value() {
    # $1=값  $2=설명
    local v="$1" m
    printf '%s' "$v" | grep -qE "$RULE_RE" && return 0
    if m=$(new_name_for "$v"); then
        if [ "$DRY_RUN" = 1 ]; then
            skip "$2: $v → $m (적용 예정)"
            return 0
        fi
        fail "$2: $v 가 이관되지 않았다 (→ $m 이어야 한다)"
        return 1
    fi
    fail "$2: $v 는 매핑에 없는 규칙 밖 값이다 — 어느 세션으로 옮길지 직접 정하라"
    return 1
}

leftover=0

    if tmux list-sessions >/dev/null 2>&1; then
        while read -r s; do
            [ -n "$s" ] || continue
            check_value "$s" "세션 이름" || leftover=1
        done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
    fi

    # 2단계와 같은 가드를 쓴다. 가드가 의도적으로 건너뛴 파일을 여기서 실패로
    # 세면, 규칙대로 올바르게 동작한 상태를 실패로 보고하고 스냅샷 저장까지
    # 잘못 막는다.
    if command -v jq >/dev/null 2>&1 && [ -d "$state_dir" ]; then
        for f in "$state_dir"/tmux__*.json; do
            [ -e "$f" ] || continue
            s=$(jq -r '.session_name // empty' "$f" 2>/dev/null)
            [ -n "$s" ] || continue
            printf '%s' "$s" | grep -qE "$RULE_RE" && continue

            i=$(jq -r '.pane_key.instance // ""' "$f" 2>/dev/null)
            b=$(jq -r '.boot_id // ""' "$f" 2>/dev/null)
            if [ -n "$sock" ] && [ "$i" != "$sock" ]; then
                skip "다른 tmux 서버의 state — 그대로 둔다: $(basename "$f") ($s)"
            elif [ -n "$boot" ] && [ "$b" != "$boot" ]; then
                skip "이전 부팅 state — resurrect 입력이라 그대로 둔다: $(basename "$f") ($s)"
            else
                check_value "$s" "agent state $(basename "$f")" || leftover=1
            fi
        done
    fi

    for repo in ${REPOS[@]+"${REPOS[@]}"}; do
        git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
        while read -r key value; do
            [ -n "$key" ] || continue
            check_value "$value" "$repo: $key" || leftover=1
        done < <(git -C "$repo" config --get-regexp '^workmux\.worktree\..*\.window-session' 2>/dev/null)
    done

[ "$leftover" = 0 ] && ok "규칙 밖 값이 남지 않았다"

echo
if [ "$rc" = 0 ]; then
    if [ "$DRY_RUN" = 1 ]; then
        echo "dry-run 완료 — 실제로 적용하려면 --dry-run 없이 다시 실행하라."
    else
        echo "완료. 이제 tmux 안에서 prefix + C-s 로 스냅샷을 다시 저장하라."
        echo "재저장하지 않으면 구 이름이 담긴 스냅샷이 복원되며 세션이 이중화된다."
    fi
elif [ "$DRY_RUN" = 1 ]; then
    echo "dry-run 에서 문제를 찾았다 — 위 ✗ 를 먼저 처리하라." >&2
    echo "지금 적용하면 일부만 이관된 상태가 된다." >&2
else
    echo "일부 항목이 실패했다 — 위 ✗ 를 확인하라." >&2
    echo "스냅샷(prefix + C-s)은 문제를 고친 뒤에 저장하라. 지금 저장하면" >&2
    echo "어긋난 상태가 스냅샷에 고착된다." >&2
fi

exit "$rc"
