#!/usr/bin/env bash
# tmux 패인을 "아래부터 쌓는" 레이아웃으로 정렬한다.
#
# 규칙 (한 행 최대 3개):
#   - 패인 2개: 예외. 좌우로 나란히 배치 (tmux 내장 even-horizontal)
#       행 단위로 쌓으면 두 패인 모두 높이가 절반으로 줄어들어, 이 개수에서는
#       전체 높이를 유지한 채 좌우로 나눈다.
#       창 너비에 따라 두 패인의 너비가 1칸까지 차이날 수 있다(tmux 관례).
#   - 패인 3개: 예외. 좌 1개(세로 전체) + 우 2개(상하)
#       workmux 기본 배치(좌 nvim / 우상 claude / 우하 codex)와 같다.
#       행 단위로 쌓으면 nvim이 상단 가로 전체가 되어 높이가 절반으로 줄어
#       편집에 불리하므로, 이 개수에서는 열 단위로 배치한다.
#       결과적으로 이 키가 workmux 레이아웃을 복구하는 역할을 한다.
#   - 패인 4~6개: 2행으로 균등 분배 (위 행 ≤ 아래 행)
#       4:2+2  5:2+3  6:3+3
#   - 패인 7개 이상: 아래 행부터 3개씩 채우고 나머지를 맨 위 행에
#       7:1+3+3  8:2+3+3  9:3+3+3  10:1+3+3+3 ...
#
# 패인 2개는 tmux 내장 even-horizontal로 처리한다. 나머지 배치는 tmux 기본
# 레이아웃에 없어 layout 문자열을 직접 생성하고 checksum을 계산해
# select-layout에 전달한다.
set -euo pipefail

read -r W H <<< "$(tmux display -p '#{window_width} #{window_height}')"
# macOS 기본 bash 3.2 호환: mapfile 대신 read 루프 사용
PANES=()
while IFS= read -r _pid; do PANES+=( "$_pid" ); done < <(tmux list-panes -F '#{pane_id}')
n=${#PANES[@]}

# 패인 1개 이하는 정렬 의미 없음
[ "$n" -le 1 ] && exit 0

# --- 2개: 좌우 배치 예외 (tmux 내장 even-horizontal) ---
# 패인 순서를 유지한 채 왼쪽→오른쪽으로 균등 분배한다.
if [ "$n" -eq 2 ]; then
  tmux select-layout even-horizontal
  exit 0
fi

# --- 3개: 열 배치 예외 (좌 1개 세로 전체 + 우 2개 상하) ---
# tmux layout 문법: {} = 좌우 분할, [] = 상하 분할
if [ "$n" -eq 3 ]; then
  avail_w=$(( W - 1 ))
  lw=$(( (avail_w + 1) / 2 ))   # 좌측이 나머지 한 칼럼을 갖는다 (tmux 관례)
  rw=$(( avail_w - lw ))
  rx=$(( lw + 1 ))

  avail_h=$(( H - 1 ))
  th=$(( (avail_h + 1) / 2 ))
  bh=$(( avail_h - th ))
  by=$(( th + 1 ))

  left="${lw}x${H},0,0,${PANES[0]#%}"
  right="${rw}x${H},${rx},0[${rw}x${th},${rx},0,${PANES[1]#%},${rw}x${bh},${rx},${by},${PANES[2]#%}]"
  layout="${W}x${H},0,0{${left},${right}}"
else

# --- 행별 패인 개수 배열(위→아래) 계산 ---
rows=()
if [ "$n" -le 6 ]; then
  top=$(( n / 2 ))            # floor(n/2)
  rows=( "$top" "$(( n - top ))" )
else
  nrows=$(( (n + 2) / 3 ))    # ceil(n/3)
  rows=( "$(( n - 3 * (nrows - 1) ))" )
  for ((i = 1; i < nrows; i++)); do rows+=( 3 ); done
fi
nrows=${#rows[@]}

# --- 행 높이 분배: H = Σ(행 높이) + (nrows-1) 경계선 ---
avail_h=$(( H - (nrows - 1) ))
base_h=$(( avail_h / nrows ))
extra_h=$(( avail_h % nrows ))

# --- layout body 생성 ---
idx=0
y=0
body=""
for ((r = 0; r < nrows; r++)); do
  rh=$base_h
  [ "$r" -lt "$extra_h" ] && rh=$(( rh + 1 ))
  cols=${rows[$r]}

  if [ "$cols" -eq 1 ]; then
    rowstr="${W}x${rh},0,${y},${PANES[$idx]#%}"
    idx=$(( idx + 1 ))
  else
    avail_w=$(( W - (cols - 1) ))
    base_w=$(( avail_w / cols ))
    extra_w=$(( avail_w % cols ))
    x=0
    colstr=""
    for ((c = 0; c < cols; c++)); do
      cw=$base_w
      [ "$c" -lt "$extra_w" ] && cw=$(( cw + 1 ))
      cell="${cw}x${rh},${x},${y},${PANES[$idx]#%}"
      colstr="${colstr:+$colstr,}$cell"
      idx=$(( idx + 1 ))
      x=$(( x + cw + 1 ))
    done
    rowstr="${W}x${rh},0,${y}{${colstr}}"
  fi

  body="${body:+$body,}$rowstr"
  y=$(( y + rh + 1 ))
done

  layout="${W}x${H},0,0[${body}]"
fi

# --- tmux layout checksum 계산 ---
csum=0
for ((i = 0; i < ${#layout}; i++)); do
  printf -v code '%d' "'${layout:$i:1}"
  csum=$(( (csum >> 1) + ((csum & 1) << 15) ))
  csum=$(( (csum + code) & 0xffff ))
done
printf -v chk '%04x' "$csum"

tmux select-layout "${chk},${layout}"
