#!/usr/bin/env bash
# tmux 패인을 개수별 규칙에 맞춰 정렬한다. 4개 이상은 아래부터 쌓고, 2·3개는
# 쌓지 않고 열 단위로 배치한다.
#
# 개수별 규칙:
#   - 패인 2개: 좌우로 나란히 배치 (결과는 tmux 내장 even-horizontal 과 같다)
#       행 단위로 쌓으면 두 패인 모두 높이가 절반으로 줄어들어, 이 개수에서는
#       전체 높이를 유지한 채 좌우로 나눈다.
#   - 패인 3개: 좌 1개(세로 전체) + 우 2개(상하)
#       workmux 기본 배치(좌 nvim / 우상 claude / 우하 codex)와 같다.
#       행 단위로 쌓으면 nvim이 상단 가로 전체가 되어 높이가 절반으로 줄어
#       편집에 불리하므로, 이 개수에서는 열 단위로 배치한다.
#       결과적으로 이 키가 workmux 레이아웃을 복구하는 역할을 한다.
#   - 패인 4개 이상: 한 행 최대 3개.
#       4~6개는 2행으로 균등 분배 (위 행 ≤ 아래 행)
#         4:2+2  5:2+3  6:3+3
#       7개 이상은 아래 행부터 3개씩 채우고 나머지를 맨 위 행에
#         7:1+3+3  8:2+3+3  9:3+3+3  10:1+3+3+3 ...
#
# 남는 칸은 항상 좌측·상단이 가져간다. 구분선이 1칸을 쓰므로 가용 폭이
# `W - (열수-1)`이 되고, 나누어떨어지지 않으면 1칸 차이가 난다 — 개수와 무관하게
# 공통이다.
#
# 모든 개수에서 layout 문자열을 직접 생성하고 checksum을 계산해 select-layout에
# 전달한다. 2개는 내장 even-horizontal 로도 같은 결과가 나오지만 쓰지 않는다 —
# 이유는 아래 2개 분기 주석 참조.
set -euo pipefail

read -r W H <<< "$(tmux display -p '#{window_width} #{window_height}')"

# floating pane(tmux 3.7의 `new-pane`, 기본 바인딩 `prefix + *`)이 있으면 정렬하지
# 않고 알린 뒤 끝낸다. select-layout 으로는 floating 을 남겨둔 채 tiled 만 정렬할
# 방법이 없다 — 실측하면:
#   - even-horizontal 은 floating 을 타일로 **흡수한다**(tiled 2 → 3, tiled 3 → 4).
#     단 tiled 가 1개면 재배치할 것이 없어 아무 일도 안 하고 성공한다(조용한 no-op).
#   - 커스텀 경로는 레이아웃 문자열의 패인 수가 창 전체 패인 수와 같아야 해서,
#     floating 을 빼고 만들면 `have N panes but need N-1` 로 거부된다.
# 흡수는 사용자가 띄워 둔 floating 창을 말없이 타일로 바꾸는 파괴적 동작이고,
# no-op 은 키를 눌렀는데 아무 반응이 없는 것이다. 둘 다 숨기지 않고 거부한다.
# floating 검사와 패인 목록을 **한 번의 list-panes** 로 함께 읽는다. 두 번 나눠 읽으면
# 그 사이에 다른 클라이언트가 만든 floating 이 검사는 통과하고 목록에는 들어와,
# 개수가 맞아떨어져 그대로 흡수된다.
# macOS 기본 bash 3.2 호환: mapfile 대신 read 루프 사용
PANES=()
has_floating=0
while read -r _flag _pid; do
  [ "$_flag" = 1 ] && has_floating=1
  PANES+=( "$_pid" )
done < <(tmux list-panes -F '#{pane_floating_flag} #{pane_id}')
n=${#PANES[@]}

if [ "$has_floating" = 1 ]; then
  tmux display-message "floating pane이 있어 정렬하지 않았다 — 닫은 뒤 다시 누르세요"
  exit 0
fi

# 패인 1개 이하는 정렬 의미 없음
[ "$n" -le 1 ] && exit 0

# --- 2개: 좌우 배치 ---
# 결과는 tmux 내장 even-horizontal 과 같지만, 내장 대신 레이아웃 문자열을 쓴다.
# 내장은 적용 시점의 창 상태를 그대로 따라가므로, 스냅샷 이후 다른 클라이언트가
# floating 을 만들면 그것까지 흡수한다. 문자열은 셀 수가 박혀 있어 패인이 **늘어난**
# 경우 `have N panes but need M` 으로 거부된다.
#
# 다만 이것이 완전한 fail-closed 는 아니다. 실측(tmux 3.7b):
#   - 패인 수가 같고 ID만 다르면 그대로 적용된다 — 문자열의 leaf ID 는 검증되지
#     않고 현재 패인 순서로 재할당된다.
#   - 패인이 **줄면** 셀을 지우고 성공한다.
# 즉 막아 주는 것은 "스냅샷 이후 패인이 늘어난 경우"뿐이다. 검사와 스냅샷을 한 번의
# list-panes 로 합친 것(위)이 실제로 의미 있는 방어이고, 이 문자열은 그 뒤에 남는
# 좁은 구간을 줄여 줄 뿐이다.
if [ "$n" -eq 2 ]; then
  avail_w=$(( W - 1 ))
  lw=$(( (avail_w + 1) / 2 ))   # 좌측이 나머지 한 칼럼을 갖는다 (tmux 관례)
  rw=$(( avail_w - lw ))
  rx=$(( lw + 1 ))
  layout="${W}x${H},0,0{${lw}x${H},0,0,${PANES[0]#%},${rw}x${H},${rx},0,${PANES[1]#%}}"

# --- 3개: 열 배치 예외 (좌 1개 세로 전체 + 우 2개 상하) ---
# tmux layout 문법: {} = 좌우 분할, [] = 상하 분할
elif [ "$n" -eq 3 ]; then
  avail_w=$(( W - 1 ))
  lw=$(( (avail_w + 1) / 2 ))   # 좌측이 나머지 한 칼럼을 갖는다 (tmux 관례)
  rw=$(( avail_w - lw ))
  rx=$(( lw + 1 ))

  avail_h=$(( H - 1 ))
  th=$(( (avail_h + 1) / 2 ))
  bh=$(( avail_h - th ))
  by=$(( th + 1 ))

  left="${lw}x${H},0,0,${PANES[0]#%}"
  right="${rw}x${H},${rx},0[${rw}x${th},${rx},0,${PANES[1]#%},${rw}x${bh},${rx},${by},${PANES[2]#%}]"
  layout="${W}x${H},0,0{${left},${right}}"
else

# --- 행별 패인 개수 배열(위→아래) 계산 ---
rows=()
if [ "$n" -le 6 ]; then
  top=$(( n / 2 ))            # floor(n/2)
  rows=( "$top" "$(( n - top ))" )
else
  nrows=$(( (n + 2) / 3 ))    # ceil(n/3)
  rows=( "$(( n - 3 * (nrows - 1) ))" )
  for ((i = 1; i < nrows; i++)); do rows+=( 3 ); done
fi
nrows=${#rows[@]}

# --- 행 높이 분배: H = Σ(행 높이) + (nrows-1) 경계선 ---
avail_h=$(( H - (nrows - 1) ))
base_h=$(( avail_h / nrows ))
extra_h=$(( avail_h % nrows ))

# --- layout body 생성 ---
idx=0
y=0
body=""
for ((r = 0; r < nrows; r++)); do
  rh=$base_h
  [ "$r" -lt "$extra_h" ] && rh=$(( rh + 1 ))
  cols=${rows[$r]}

  if [ "$cols" -eq 1 ]; then
    rowstr="${W}x${rh},0,${y},${PANES[$idx]#%}"
    idx=$(( idx + 1 ))
  else
    avail_w=$(( W - (cols - 1) ))
    base_w=$(( avail_w / cols ))
    extra_w=$(( avail_w % cols ))
    x=0
    colstr=""
    for ((c = 0; c < cols; c++)); do
      cw=$base_w
      [ "$c" -lt "$extra_w" ] && cw=$(( cw + 1 ))
      cell="${cw}x${rh},${x},${y},${PANES[$idx]#%}"
      colstr="${colstr:+$colstr,}$cell"
      idx=$(( idx + 1 ))
      x=$(( x + cw + 1 ))
    done
    rowstr="${W}x${rh},0,${y}{${colstr}}"
  fi

  body="${body:+$body,}$rowstr"
  y=$(( y + rh + 1 ))
done

  layout="${W}x${H},0,0[${body}]"
fi

# --- tmux layout checksum 계산 ---
csum=0
for ((i = 0; i < ${#layout}; i++)); do
  printf -v code '%d' "'${layout:$i:1}"
  csum=$(( (csum >> 1) + ((csum & 1) << 15) ))
  csum=$(( (csum + code) & 0xffff ))
done
printf -v chk '%04x' "$csum"

# 실패하면(대개 검사 이후 패인이 늘거나 줄어 `have N panes but need M`) 조용히
# 넘어가지 않고 알린다. 레이아웃은 적용되지 않은 상태로 남는다.
if ! err=$(tmux select-layout "${chk},${layout}" 2>&1); then
  tmux display-message "레이아웃 정렬 실패 — 패인 구성이 바뀌었습니다. 다시 누르세요"
  echo "select-layout 실패: $err" >&2
  exit 1
fi
