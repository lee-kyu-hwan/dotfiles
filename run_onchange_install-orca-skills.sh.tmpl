{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Orca 번들 스킬 설치 (macOS only)
#
# 이 목록이 바뀔 때마다 재실행된다: orchestration orca-cli
#
# 스킬 파일을 저장소에 복사해 두지 않고 설치 명령만 둔다. Orca 는 자기 버전에 맞는
# 스킬 저장소·리비전을 알고 있고(`orca skills list`), 앱을 업데이트하면 스킬도 그에
# 맞춰 갱신해야 하기 때문이다. 파일을 vendoring 하면 그 정합성을 사람이 손으로
# 따라가야 한다.
#
# `--agent` 를 반드시 지정한다. 생략하면 community skills CLI 가 감지한 모든 에이전트에
# 설치해 쓰지도 않는 홈(~/.commandcode, ~/.hermes, ~/.grok 등)에 링크를 흩뿌린다.
# claude-code 는 심링크 대상이고 universal 은 공용 ~/.agents/skills 다.
#
# 실물은 ~/.agents/skills/<스킬>, ~/.claude/skills/<스킬> 은 그리로 향하는 심링크다.
# 둘 다 chezmoi 가 관리하는 디렉터리지만 이 스킬들은 관리 대상에 넣지 않는다 —
# 외부 저장소의 산출물이라 정본이 Orca 쪽에 있다.
set -euo pipefail

ORCA_BIN="/Applications/Orca.app/Contents/Resources/bin/orca"

# Orca 미설치 머신에서는 조용히 건너뛴다.
if [[ ! -x "$ORCA_BIN" ]]; then
    exit 0
fi

"$ORCA_BIN" skills install \
    --skill orchestration \
    --skill orca-cli \
    --agent claude-code,universal
{{ end -}}
