{
  "model": "opus[1m]",
  "effortLevel": "high",
  "permissions": {
    "allow": ["WebSearch", "WebFetch(domain:*)"],
    "deny": ["Bash(git push:*)"],
    "defaultMode": "dontAsk"
  },
  "sandbox": {"enabled": true, "autoAllowBashIfSandboxed": false},
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "ai-agent-ghostty-notify", "args": ["Claude Code"]}]},
      {"hooks": [{"command": "workmux set-window-status done", "type": "command"}]}
    ],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "ai-agent-ghostty-notify", "args": ["Claude Subagent"]}]}],
    "TaskCompleted": [{"hooks": [{"type": "command", "command": "ai-agent-ghostty-notify", "args": ["Claude Task"]}]}],
    "Notification": [
      {"hooks": [{"type": "command", "command": "ai-agent-ghostty-notify", "args": ["Claude Code"]}]},
      {"matcher": "permission_prompt|elicitation_dialog", "hooks": [{"command": "workmux set-window-status waiting", "type": "command"}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "ai-agent-ghostty-notify", "args": ["Claude Code"]}]},
      {"hooks": [{"command": "workmux set-window-status waiting", "type": "command"}]}
    ],
    "PostToolUse": [{"hooks": [{"command": "workmux set-window-status working", "type": "command"}]}],
    "UserPromptSubmit": [{"hooks": [{"command": "workmux set-window-status working", "type": "command"}]}]
  }
}
