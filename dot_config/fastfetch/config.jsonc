{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/macgraw.txt",
    "type": "file",
    "position": "top",
    "color": {
      // $1: red comb / hat
      "1": "#c44a3d",
      // $2: Matrix green body
      "2": "#00ff41",
      // $3: orange beak
      "3": "#e5892d",
      // $4: dark gray eyes / brow
      "4": "#30343a"
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "packages",
    "uptime"
  ]
}
