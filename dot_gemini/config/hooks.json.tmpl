{{- /*
Orca 가 런타임에 orca-status 블록을 이 파일에 주입한다. source 에 그 블록이 없으면
chezmoi apply 가 지우고, chezmoi add 로 받으면 홈 절대경로가 그대로 박힌다. 그래서
두 블록을 모두 source 에 두고 홈 경로만 .chezmoi.homeDir 로 치환한다.

.codex/config.toml 은 Codex 가 값 표현까지 정규화해 영구 drift 가 되므로
.chezmoiignore 로 제외했지만, Orca 는 남의 키를 건드리지 않고 자기 키만 덧붙인다
(실측: 주입 후에도 workmux-status 블록이 바이트 단위로 동일). 그래서 이 파일은
제외가 아니라 템플릿으로 관리한다.

유지 비용: Orca 를 업데이트하면 훅 명령 문자열이 바뀔 수 있다. 그때는
chezmoi status 로 drift 를 확인하고 이 파일을 갱신한다.

workmux-status.PreToolUse 는 agy 의 모든 도구를 차단한다(#164). 여기서는 현상을
그대로 보존하고, 제거는 #164 에서 별도로 다룬다.
*/ -}}
{
  "workmux-status": {
    "PreInvocation": [
      {
        "command": "workmux set-window-status working >/dev/null 2>&1 || true; printf '{}\\n'",
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working >/dev/null 2>&1 || true; printf '{}\\n'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "command": "workmux set-window-status done >/dev/null 2>&1 || true; printf '{}\\n'",
        "type": "command"
      }
    ]
  },
  "orca-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ]; then ORCA_ANTIGRAVITY_EVENT='PreInvocation' /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ]; then ORCA_ANTIGRAVITY_EVENT='PostInvocation' /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ]; then ORCA_ANTIGRAVITY_EVENT='Stop' /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ]; then ORCA_ANTIGRAVITY_EVENT='PreToolUse' /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh'; else printf '%s\\n' '{\"decision\":\"ask\"}'; { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh' ]; then ORCA_ANTIGRAVITY_EVENT='PostToolUse' /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/antigravity-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
