set -g mouse on

# 터미널의 포커스 변화를 tmux에 전달한다. 이게 off면 pane-focus-in 훅이
# 발동하지 않는다 — 아래 macism 입력기 전환 훅 중 하나가 이 이벤트를 쓴다.
# (after-select-pane/window는 tmux 내부 이벤트라 이 옵션과 무관하게 동작한다)
set -g focus-events on

# tmux 서버는 데몬이라 오래 살아남는다. Ghostty를 재시작하면 새 환경변수가
# 생기는데, update-environment에 없으면 서버가 옛 값을 계속 물려준다.
# 기본값에는 Ghostty 관련 항목이 하나도 없어 직접 추가한다.
set -ga update-environment GHOSTTY_RESOURCES_DIR
set -ga update-environment GHOSTTY_BIN_DIR
set -ga update-environment GHOSTTY_SHELL_FEATURES
set -ga update-environment TERM_PROGRAM
set -ga update-environment TERM_PROGRAM_VERSION
set -ga update-environment TERMINFO

# ============================================================
# 클립보드 및 복사 설정 (OSC 52 지원)
# ============================================================
# tmux가 터미널(Ghostty)에 클립보드 내용을 전달하도록 허용
set -s set-clipboard on

# 복사 모드 (VI 스타일) 활성화
set-window-option -g mode-keys vi

# 선택 및 복사 단축키 (Vim 스타일)
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# 마우스 드래그를 무조건 tmux copy-mode로 처리 (정렬 유지 복사)
#   - 에이전트 TUI(codex/claude)는 마우스 리포팅을 켜므로, tmux 기본값은
#     드래그를 앱으로 넘겨버림 → Ghostty 네이티브 선택으로 흘러가 정렬이 깨짐.
#   - 드래그를 강제로 copy-mode로 보내 tmux grid 기준(wrap 인식)으로 복사.
#   - 클릭/스크롤은 그대로 앱에 전달됨. (드래그만 copy-mode 우선)
bind-key -n MouseDrag1Pane copy-mode -M
bind-key -T copy-mode-vi MouseDrag1Pane    send-keys -X begin-selection
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel

# 한글 입력 상태에서 copy-mode 종료 (ㅂ = q, 안전망)
bind-key -T copy-mode-vi ㅂ send-keys -X cancel

# "0"번 세션 이름을 "main"으로 자동 변경
set-hook -g session-created 'if -F "#{==:#{session_name},0}" "rename-session main"'

{{ if eq .chezmoi.os "darwin" -}}
# ============================================================
# 한글 입력 호환 설정 (macOS only)
# ============================================================

# --- 1. Ctrl+B 누르는 순간 영문 전환 (핵심) ---
set -g prefix M-F12
bind -n C-b switch-client -T prefix \; run-shell -b "macism com.apple.keylayout.ABC"
bind C-b send-keys C-b

# --- 1-2. copy-mode 진입 시 영문 전환 (마우스 스크롤 포함) ---
set-hook -g pane-mode-changed 'if -F "#{pane_in_mode}" "run -b \"macism com.apple.keylayout.ABC\""'

# --- 1-1. 자음 바인딩 (안전망) ---
bind ㅈ choose-tree -Zw         # w
bind ㅊ new-window              # c
bind ㄷ detach-client            # d
bind ㅜ next-window              # n
bind ㅍ previous-window          # p
bind ㅌ confirm-before -p "kill-pane #P? (y/n)" kill-pane  # x
bind ㅋ resize-pane -Z           # z
bind ㄴ choose-tree -Zs          # s
bind ㅐ select-pane -t :.+       # o
bind ㅣ select-layout next       # l
bind ㅂ display-panes            # q
bind ㅅ clock-mode               # t

# --- 2. macism 훅 (상태 초기화) ---
set-hook -g after-select-pane   'run-shell -b "macism com.apple.keylayout.ABC"'
set-hook -g after-select-window 'run-shell -b "macism com.apple.keylayout.ABC"'
# 주의: pane-focus-in은 윈도우 스코프 훅이라 -g가 아니라 -gw로 설정해야
# tmux가 등록한다. -g로 두면 조용히 무시된다. focus-events on도 함께 필요하다.
set-hook -gw pane-focus-in      'run-shell -b "macism com.apple.keylayout.ABC"'

# --- 3. 명령어 모드 강제 전환 ---
bind : run-shell "macism com.apple.keylayout.ABC" \; command-prompt

{{ else -}}
# ============================================================
# Linux: 표준 prefix
# ============================================================
set -g prefix C-b
bind C-b send-prefix

{{ end -}}
# ============================================================
# 직관적인 패널 분할 (현재 경로 유지)
# ============================================================
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# ============================================================
# 윈도우 이동 (Shift+←/→) / 순서 변경 (Ctrl+Shift+←/→)
# ============================================================
bind-key -n S-Left  previous-window
bind-key -n S-Right next-window
bind-key -n C-S-Left  swap-window -t -1 \; previous-window
bind-key -n C-S-Right swap-window -t +1 \; next-window

# ============================================================
# 윈도우 번호 자동 정렬 (빈 번호 메우기)
#   - 윈도우 닫을 때 자동 재번호 (renumber-windows)
#   - prefix + R 로 즉시 재정렬 (move-window -r)
# ============================================================
set -g renumber-windows on
bind R move-window -r \; display-message "윈도우 번호 재정렬 완료"

# ============================================================
# 패인 특정 위치로 이동 (prefix + S → 번호 입력)
#   각 패인에 번호가 표시되고, 번호를 누르면 현재 패인과 그 패인이 교체된다.
#   -d 0: 키를 누를 때까지 번호 표시 유지
# ============================================================
bind S display-panes -d 0 "swap-pane -t %%"

# ============================================================
# 설정 리로드
# ============================================================
bind r source-file ~/.tmux.conf \; display-message "tmux.conf 리로드 완료"

# ============================================================
# 화면 + 스크롤백 클리어 (prefix + C-l, vim-tmux-navigator가 C-l 사용)
# ============================================================
bind C-l send-keys -R C-l \; clear-history

# ============================================================
# Pane 구분: 비활성 pane 어둡게 처리
# ============================================================
set -g window-style 'bg=colour238'
set -g window-active-style 'bg=colour0'
set -g pane-border-style fg=colour238
set -g pane-active-border-style fg=colour51

# ============================================================
# Pane 레이아웃 정렬 (prefix + =) — 아래부터 쌓는 스택 레이아웃
#   한 행 최대 3개. 6개 이하는 2행 균등(위≤아래), 7개부터는 아래 행부터
#   3개씩 채우고 나머지를 맨 위에. (2:1+1 3:1+2 5:2+3 7:1+3+3 ...)
#   tmux 기본 레이아웃에 없어 스크립트로 layout 문자열을 동적 생성한다.
# ============================================================
bind = run-shell "$HOME/.local/bin/tmux-stack-layout"

# ============================================================
# workmux (worktree + 에이전트)
#
# 사이드바는 쓰지 않는다 — 윈도우마다 pane을 하나씩 차지해 작업 pane이 좁아지고
# 3-pane 레이아웃이 재배치된다. 상태는 window-status-format의 @workmux_status로
# 항상 보이고, 자세히 볼 때만 dashboard를 popup으로 띄운다 (pane 소비 0).
# ============================================================
bind W display-popup -h 85% -w 90% -E "workmux dashboard"
bind G run-shell "workmux last-done"     # 마지막으로 끝난 에이전트로 이동
bind Tab run-shell "workmux last-agent"  # 마지막 에이전트로 이동

# ============================================================
# OSC 시퀀스 패스스루
# ============================================================
set -g allow-passthrough on

# ============================================================
# 상태바
# ============================================================

# 스타일
set -g status-style "bg=colour236,fg=colour248"
set -g status-left-length 30
set -g status-right-length 60

# 왼쪽: 세션 이름
set -g status-left "#[fg=colour16,bg=colour75,bold] #S #[fg=colour75,bg=colour236] "

# 오른쪽: 날짜/시간
set -g status-right "#[fg=colour248] %m/%d %H:%M "

# 윈도우 탭: 비활성 (상태별 색상 분기)
#   activity (출력 중)    = 초록 ● (진행 중)
#   silence (20초 무출력) = 빨강 ⏸ (작업 완료/대기 — 확인 필요)
#   일반                  = 회색 (idle)
#   @workmux_status       = workmux 에이전트 상태 (🤖 작업중 / 💬 입력대기 / ✅ 완료)
#   window_zoomed_flag    = 🔍 (pane 하나가 전체화면으로 확대된 상태)
#
# workmux는 status_format: false일 때 포맷을 덮지 않고 @workmux_status만
# export한다. 아래처럼 직접 참조해야 ⏸/● 표시와 함께 보인다.
#
# zoom 표시가 필요한 이유: tmux 기본 포맷은 #{window_flags}로 Z를 붙이는데
# 이 커스텀 포맷은 그것을 쓰지 않는다. 표시가 없으면 zoom 상태로 두고 잊었을 때
# "다른 pane이 사라졌다"고 착각하게 된다.
set -g window-status-format "#{?window_silence_flag,#[fg=colour196 bold] #I #W ⏸ ,#{?window_activity_flag,#[fg=colour46 bold] #I #W ● , #I #W }}#{?@workmux_status,#{@workmux_status} ,}#{?window_zoomed_flag,🔍 ,}"

# 윈도우 탭: 현재 활성
set -g window-status-current-format "#[fg=colour16,bg=colour39,bold] #I #W #{?@workmux_status,#{@workmux_status} ,}#{?window_zoomed_flag,🔍 ,}"

# Activity + Silence 모니터링
set -g monitor-activity on
set -g monitor-silence 20
set -g visual-activity off
set -g visual-silence off

# 구분선
set -g window-status-separator ""

# 상태바 위치
set -g status-position bottom

# 상태바 갱신 주기 (초)
set -g status-interval 5

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# vim-tmux-navigator: prefix C-l 자동 매핑 비활성화
#   → 플러그인이 prefix C-l을 안 건드리므로, 위의 사용자 정의
#     "화면 + 스크롤백 클리어"(bind C-l ... clear-history)가 살아난다
set -g @vim_navigator_prefix_mapping_clear_screen ""

# resurrect: pane 내용 캡처 + 저장 경로 지정
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-dir '~/.local/share/tmux/resurrect'

# continuum: 15분마다 자동 저장 + tmux 시작 시 자동 복원
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

run '~/.tmux/plugins/tpm/tpm'
