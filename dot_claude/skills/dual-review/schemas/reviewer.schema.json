{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict", "summary", "findings", "next_steps"],
  "properties": {
    "verdict": {"type": "string"},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "original_id", "severity", "title", "body", "file", "line_start", "line_end", "finding_confidence", "recommendation"],
        "properties": {
          "source": {"type": "string"},
          "original_id": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "title": {"type": "string"}, "body": {"type": "string"},
          "file": {"type": "string"}, "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "finding_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "recommendation": {"type": "string"}
        }
      }
    },
    "next_steps": {"type": "array", "items": {"type": "string"}}
  }
}
